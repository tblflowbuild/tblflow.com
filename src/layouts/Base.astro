---
import BaseHead from '@/components/BaseHead.astro';
import JsonLd from '@/components/JsonLd.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { HREFLANG, type Locale } from '@/config';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; path: string }>;
  faq?: Array<{ question: string; answer: string }>;
  article?: {
    headline: string;
    description: string;
    publishedAt: Date;
    updatedAt?: Date;
    author: string;
    image?: string;
  };
  product?: boolean;
}

const {
  locale,
  title,
  description,
  path,
  image,
  ogType,
  noindex,
  breadcrumbs,
  faq,
  article,
  product,
} = Astro.props;
---

<!doctype html>
<html lang={HREFLANG[locale]}>
  <head>
    <BaseHead
      locale={locale}
      title={title}
      description={description}
      path={path}
      image={image}
      ogType={ogType}
      noindex={noindex}
      publishedAt={article?.publishedAt}
      updatedAt={article?.updatedAt}
    />
    <JsonLd
      locale={locale}
      path={path}
      title={title}
      description={description}
      breadcrumbs={breadcrumbs}
      faq={faq}
      article={article}
      product={product}
    />
  </head>

  <body class="min-h-dvh antialiased">
    {/*
      One background for the whole page, not one per section.

      `position: fixed` rather than sized to page height: it paints the full
      viewport regardless of how long the page is and never has to be told the
      document's height, which a tall `absolute` layer sized from a parent
      would. It sits behind everything (`-z-10`) and ignores clicks.

      The hero keeps its own richer treatment on top of this (spotlight, drifting
      glow, hex mask) — that layering is the "fusion" this one is not meant to
      replace, only to continue underneath it and past it, so the rest of the
      page stops reading as alternating plain and decorated sections.
    */}
    <div class="pointer-events-none fixed inset-0 -z-10" aria-hidden="true">
      <div class="bg-grid absolute inset-0"></div>
      <div class="spotlight absolute inset-0 opacity-40"></div>
    </div>

    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
