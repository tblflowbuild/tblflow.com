---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Journey from '@/components/Journey.astro';
import PricingTable from '@/components/PricingTable.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import { FAQ } from '@/data/faq';
import { pm } from '@/data/processMap';
import Testimonials from '@/components/Testimonials.astro';
import { useTranslations } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
import { LOCALES, type Locale } from '@/config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

const meta = {
  title: pm(locale, 'home.meta.title'),
  description: pm(locale, 'home.meta.description'),
};

/** Same strings the FAQ renders — one source, so text and schema cannot diverge. */
const faqSchema = FAQ.map((item) => ({
  question: item.question[locale],
  answer: item.answer[locale],
}));
---

<Base
  locale={locale}
  title={meta.title}
  description={meta.description}
  path={localePath(locale)}
  faq={faqSchema}
  product
>
  <Hero locale={locale} />

  {/* The story in the order a company lives it, from the problem to the time
      handed back to the team. The detail pages (views, surfaces, MCP,
      comparisons) are linked from the header, the footer and the pricing. */}
  <Journey locale={locale} />

  <Testimonials locale={locale} />

  <div class="mx-auto max-w-6xl border-t border-[var(--border)] px-4 pt-16 sm:px-6 sm:pt-20">
    <header class="max-w-2xl">
      <h2 class="text-3xl font-medium sm:text-4xl">{t('pricing.title')}</h2>
      <p class="mt-3 text-lg text-[var(--fg-muted)]">{t('pricing.subtitle')}</p>
      <a
        href={localePath(locale, 'compare')}
        class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-[var(--color-ai-2)] hover:underline"
      >
        {t('compare.seeAll')}
        <span aria-hidden="true">→</span>
      </a>
    </header>
  </div>
  <PricingTable locale={locale} showQuotas={false} />

  <Faq locale={locale} />

  <CtaBand locale={locale} />
</Base>
