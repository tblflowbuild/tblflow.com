---
/**
 * Signpost, not a contract.
 *
 * This page used to carry a full 14-article CGVU — a second copy of the
 * agreement that actually governs the application. Two copies of one contract,
 * in two repositories, diverge the first time only one is amended, and the
 * visitor has no way to tell which one binds. So the page keeps its URL, its
 * place in the footer and its search presence, and spends them pointing at the
 * authoritative text instead of competing with it.
 */
import Base from '@/layouts/Base.astro';
import { useTranslations } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
import { APP_LEGAL, LOCALES, type Locale } from '@/config';
import { TERMS_TITLE, TERMS_SIGNPOST } from '@/data/legal';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const path = localePath(locale, 'terms');
const signpost = TERMS_SIGNPOST[locale];

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: localePath(locale) },
  { name: TERMS_TITLE[locale], path },
];
---

<Base
  locale={locale}
  title={`${TERMS_TITLE[locale]} — TblFlow`}
  description={signpost.lede}
  path={path}
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-2xl px-4 pt-16 pb-24 sm:px-6 sm:pt-24">
    <h1 class="animate-enter text-4xl font-bold tracking-tight sm:text-5xl">
      {TERMS_TITLE[locale]}
    </h1>

    <p class="animate-enter delay-1 mt-6 text-lg text-[var(--fg-muted)]">{signpost.lede}</p>

    <a
      href={APP_LEGAL.terms}
      class="ai-gradient-bg animate-gradient animate-enter delay-2 mt-8 inline-block rounded-lg px-5 py-3 text-sm font-semibold text-white shadow-md shadow-indigo-500/20 transition-transform hover:-translate-y-px"
    >
      {signpost.cta}
    </a>
  </div>
</Base>
