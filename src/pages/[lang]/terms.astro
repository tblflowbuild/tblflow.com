---
/**
 * CGVU (terms of service) — same rationale as legal.astro: French contract
 * law, one authoritative French body reused on every locale route rather than
 * ten paraphrases of it.
 */
import Base from '@/layouts/Base.astro';
import { useTranslations } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
import { LOCALES, type Locale } from '@/config';
import { TERMS_TITLE, TERMS_NOTE, TERMS_SECTIONS, TERMS_LAST_UPDATED } from '@/data/legal';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const path = localePath(locale, 'terms');

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: localePath(locale) },
  { name: TERMS_TITLE[locale], path },
];
---

<Base
  locale={locale}
  title={`${TERMS_TITLE[locale]} — TblFlow`}
  description={TERMS_TITLE[locale]}
  path={path}
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-4xl px-4 pt-16 pb-20 sm:px-6 sm:pt-24">
    <h1 class="animate-enter text-4xl font-bold tracking-tight sm:text-5xl">
      {TERMS_TITLE[locale]}
    </h1>

    <p class="animate-enter delay-1 mt-4 text-sm text-[var(--fg-subtle)]">
      {TERMS_LAST_UPDATED[locale]}
    </p>
    {
      TERMS_NOTE[locale] && (
        <p class="animate-enter delay-1 mt-2 text-sm text-[var(--fg-subtle)]">{TERMS_NOTE[locale]}</p>
      )
    }

    <div class="prose-site reveal mt-10" lang="fr">
      {
        TERMS_SECTIONS.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))
      }
    </div>
  </div>
</Base>
