---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '@/i18n/ui';
import { localePath, formatDate, isoDate } from '@/i18n/utils';
import { LOCALES, type Locale } from '@/config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

/**
 * Posts are filtered by the locale directory in their id (`fr/slug`), not by a
 * frontmatter field — the path is the single source of truth for a post's locale.
 * Drafts are excluded from listings, feeds and the sitemap alike.
 */
const posts = (await getCollection('blog', ({ id, data }) => id.startsWith(`${locale}/`) && !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const slugOf = (id: string) => id.replace(`${locale}/`, '');

const meta = {
  de: {
    title: 'TblFlow-Blog — Produkt, Anleitungen und Engineering',
    description:
      'Produktnotizen, praktische Anleitungen und Engineering-Berichte zu TblFlow: No-Code-Datenbanken, KI-Agenten, Automatisierungen und PostgreSQL.',
  },
  en: {
    title: 'TblFlow blog — product, guides and engineering',
    description:
      'Product notes, practical guides and engineering write-ups on TblFlow: no-code databases, AI agents, automations and PostgreSQL.',
  },
  es: {
    title: 'Blog de TblFlow — producto, guías e ingeniería',
    description:
      'Notas de producto, guías prácticas y artículos de ingeniería sobre TblFlow: bases de datos no-code, agentes IA, automatizaciones y PostgreSQL.',
  },
  fr: {
    title: 'Blog TblFlow — produit, guides et ingénierie',
    description:
      "Notes de produit, guides pratiques et retours d'ingénierie sur TblFlow : bases de données no-code, agents IA, automatisations et PostgreSQL.",
  },
  it: {
    title: 'Blog TblFlow — prodotto, guide e ingegneria',
    description:
      'Note di prodotto, guide pratiche e approfondimenti tecnici su TblFlow: database no-code, agenti IA, automazioni e PostgreSQL.',
  },
  ja: {
    title: 'TblFlow ブログ — 製品、ガイド、エンジニアリング',
    description:
      'TblFlowに関する製品ノート、実践ガイド、エンジニアリング記事：ノーコードデータベース、AIエージェント、自動化、PostgreSQL。',
  },
  ru: {
    title: 'Блог TblFlow — продукт, руководства и инженерия',
    description:
      'Заметки о продукте, практические руководства и инженерные материалы о TblFlow: no-code базы данных, ИИ-агенты, автоматизации и PostgreSQL.',
  },
  tr: {
    title: 'TblFlow blogu — ürün, rehberler ve mühendislik',
    description:
      'TblFlow hakkında ürün notları, pratik rehberler ve mühendislik yazıları: no-code veritabanları, yapay zeka ajanları, otomasyonlar ve PostgreSQL.',
  },
  uk: {
    title: 'Блог TblFlow — продукт, гайди та інженерія',
    description:
      'Нотатки про продукт, практичні гайди та інженерні матеріали про TblFlow: no-code бази даних, ШІ-агенти, автоматизації та PostgreSQL.',
  },
  zh: {
    title: 'TblFlow 博客 — 产品、指南与工程实践',
    description:
      '关于 TblFlow 的产品动态、实用指南与工程文章：无代码数据库、AI 智能体、自动化与 PostgreSQL。',
  },
} satisfies Record<Locale, { title: string; description: string }>;

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: localePath(locale) },
  { name: t('blog.title'), path: localePath(locale, 'blog') },
];
---

<Base
  locale={locale}
  title={meta[locale].title}
  description={meta[locale].description}
  path={localePath(locale, 'blog')}
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-4xl px-4 pt-16 sm:px-6 sm:pt-24">
    <h1 class="animate-enter text-4xl font-bold tracking-tight sm:text-5xl">{t('blog.title')}</h1>
    <p class="animate-enter delay-1 mt-4 text-lg text-[var(--fg-muted)]">{t('blog.subtitle')}</p>

    {
      posts.length === 0 ? (
        <p class="mt-16 text-[var(--fg-subtle)]">{t('blog.empty')}</p>
      ) : (
        <ul class="mt-14 space-y-4">
          {posts.map((post) => (
            <li class="reveal">
              <a
                href={localePath(locale, `blog/${slugOf(post.id)}`)}
                class="card group block p-6 transition-shadow hover:shadow-lg"
              >
                <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--fg-subtle)]">
                  <time datetime={isoDate(post.data.publishedAt)}>
                    {formatDate(post.data.publishedAt, locale)}
                  </time>
                  {post.data.tags.length > 0 && (
                    <ul class="flex flex-wrap gap-1.5">
                      {post.data.tags.map((tag) => (
                        <li class="rounded-full bg-[var(--bg-subtle)] px-2 py-0.5">{tag}</li>
                      ))}
                    </ul>
                  )}
                </div>

                <h2
                  class="mt-3 text-xl font-semibold transition-colors group-hover:text-[var(--color-ai-2)]"
                >
                  {post.data.title}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">
                  {post.data.description}
                </p>

                <span
                  class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-ai-2)]"
                >
                  {t('blog.readmore')}
                  <svg
                    class="transition-transform group-hover:translate-x-0.5"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M5 12h14M13 6l6 6-6 6"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
