---
import Base from '@/layouts/Base.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { useTranslations } from '@/i18n/ui';
import { localePath, formatDate, isoDate, readingTime } from '@/i18n/utils';
import { isLocale, type Locale } from '@/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.flatMap((post) => {
    // ids look like `fr/my-post`; the first segment is the locale.
    const [lang, ...rest] = post.id.split('/');
    if (!lang || !isLocale(lang) || rest.length === 0) return [];
    return [{ params: { lang, slug: rest.join('/') }, props: { post } }];
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post }: Props = Astro.props;
const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

const { Content, headings } = await render(post);
const minutes = readingTime(post.body ?? '');
const slug = post.id.replace(`${locale}/`, '');
const path = localePath(locale, `blog/${slug}`);

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: localePath(locale) },
  { name: t('blog.title'), path: localePath(locale, 'blog') },
  { name: post.data.title, path },
];

/** Only h2/h3 — deeper levels make a marketing-blog TOC unreadable. */
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<Base
  locale={locale}
  title={`${post.data.title} — TblFlow`}
  description={post.data.description}
  path={path}
  image={post.data.image}
  ogType="article"
  breadcrumbs={breadcrumbs}
  article={{
    headline: post.data.title,
    description: post.data.description,
    publishedAt: post.data.publishedAt,
    updatedAt: post.data.updatedAt,
    author: post.data.author,
    image: post.data.image,
  }}
>
  <article class="mx-auto max-w-4xl px-4 pt-14 sm:px-6 sm:pt-20">
    <a
      href={localePath(locale, 'blog')}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--fg-muted)] transition-colors hover:text-[var(--fg)]"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M19 12H5M11 18l-6-6 6-6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      {t('blog.back')}
    </a>

    <header class="mt-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">{post.data.title}</h1>

      <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-[var(--fg-subtle)]">
        <span>{post.data.author}</span>
        <span aria-hidden="true">·</span>
        <span>
          {t('blog.published')}
          <time datetime={isoDate(post.data.publishedAt)}>
            {formatDate(post.data.publishedAt, locale)}
          </time>
        </span>
        <span aria-hidden="true">·</span>
        <span>{minutes} {t('blog.readingtime')}</span>
      </div>

      {
        post.data.updatedAt && (
          <p class="mt-1 text-xs text-[var(--fg-subtle)]">
            {t('blog.updated')}
            <time datetime={isoDate(post.data.updatedAt)}>
              {formatDate(post.data.updatedAt, locale)}
            </time>
          </p>
        )
      }

      {
        post.data.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-1.5 text-xs">
            {post.data.tags.map((tag) => (
              <li class="rounded-full bg-[var(--bg-subtle)] px-2.5 py-1 text-[var(--fg-muted)]">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      toc.length > 2 && (
        <nav aria-labelledby="toc-heading" class="card mt-10 p-5">
          <h2 id="toc-heading" class="text-xs font-semibold tracking-wide uppercase">
            {t('blog.toc')}
          </h2>
          <ol class="mt-3 space-y-1.5 text-sm">
            {toc.map((heading) => (
              <li class:list={[heading.depth === 3 && 'pl-4']}>
                <a
                  href={`#${heading.slug}`}
                  class="text-[var(--fg-muted)] transition-colors hover:text-[var(--color-ai-2)]"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose-site mt-12">
      <Content />
    </div>
  </article>
</Base>
