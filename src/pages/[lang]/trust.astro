---
import Base from '@/layouts/Base.astro';
import { useTranslations } from '@/i18n/ui';
import { localePath, brandTitle } from '@/i18n/utils';
import { LOCALES, type Locale } from '@/config';
import { TRUST } from '@/data/trust';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const texts = TRUST[locale];
const path = localePath(locale, 'trust');

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: localePath(locale) },
  { name: texts.title, path },
];
---

<Base
  locale={locale}
  title={brandTitle(texts.title)}
  description={texts.description}
  path={path}
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-4xl px-4 pt-16 pb-20 sm:px-6 sm:pt-24">
    <h1 class="animate-enter text-4xl font-medium sm:text-5xl">{texts.title}</h1>
    <p class="animate-enter delay-1 mt-4 max-w-2xl text-lg text-[var(--fg-muted)]">{texts.intro}</p>

    <div class="mt-10 grid gap-4">
      {
        texts.sections.map((section) => (
          <section class="rounded-xl border border-[var(--border)] p-5">
            <h2 class="text-lg font-medium">{section.title}</h2>
            <p class="mt-1 text-[var(--fg-muted)]">{section.text}</p>
          </section>
        ))
      }
    </div>
  </div>
</Base>
