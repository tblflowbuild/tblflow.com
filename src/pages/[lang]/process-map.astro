---
import Base from '@/layouts/Base.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import ProcessMapViz from '@/components/ProcessMapViz.astro';
import { FAQ } from '@/data/faq';
import { pm } from '@/data/processMap';
import { useTranslations } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
import { APP_URL, LOCALES, type Locale } from '@/config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

const four = [1, 2, 3, 4] as const;
const three = [1, 2, 3] as const;
const seven = [1, 2, 3, 4, 5, 6, 7] as const;

/** Only this page's own questions, so the FAQPage schema matches what is on screen. */
const faqSchema = FAQ.filter((item) => item.topic === 'process-map').map((item) => ({
  question: item.question[locale],
  answer: item.answer[locale],
}));

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: localePath(locale) },
  { name: pm(locale, 'breadcrumb'), path: localePath(locale, 'process-map') },
];
---

<Base
  locale={locale}
  title={pm(locale, 'meta.title')}
  description={pm(locale, 'meta.description')}
  path={localePath(locale, 'process-map')}
  breadcrumbs={breadcrumbs}
  faq={faqSchema}
>
  <section class="mx-auto max-w-4xl px-4 pt-16 text-center sm:px-6 sm:pt-24">
    <p class="animate-enter text-sm font-semibold uppercase tracking-wide text-[var(--color-ai-2)]">
      {pm(locale, 'hero.eyebrow')}
    </p>
    <h1 class="animate-enter delay-1 mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
      {pm(locale, 'hero.title')}
    </h1>
    <p class="animate-enter delay-2 mx-auto mt-4 max-w-2xl text-lg text-[var(--fg-muted)]">
      {pm(locale, 'hero.subtitle')}
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={`${APP_URL}/auth/signup`}
        class="ai-gradient-bg animate-gradient w-full rounded-xl px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-indigo-500/20 transition-transform hover:-translate-y-0.5 sm:w-auto"
      >
        {pm(locale, 'hero.cta.primary')}
      </a>
      <a
        href={localePath(locale, 'pricing')}
        class="w-full rounded-xl border border-[var(--border-strong)] px-6 py-3.5 text-base font-semibold transition-colors hover:bg-[var(--bg-subtle)] sm:w-auto"
      >
        {pm(locale, 'hero.cta.secondary')}
      </a>
    </div>
    <p class="mt-4 text-sm text-[var(--fg-subtle)]">{pm(locale, 'hero.note')}</p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    {
      locale === 'fr' ? (
        <figure class="reveal mx-auto max-w-5xl">
          <img
            src="/images/process-map/who-does-what-fr-dark.webp"
            alt={pm(locale, 'shot.alt')}
            width="1600"
            height="938"
            class="card h-auto w-full"
            fetchpriority="high"
          />
          <figcaption class="mt-3 text-center text-sm text-[var(--fg-subtle)]">
            {pm(locale, 'shot.caption')}
          </figcaption>
        </figure>
      ) : (
        <ProcessMapViz locale={locale} />
      )
    }
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <header class="reveal max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{pm(locale, 'problem.title')}</h2>
      <p class="mt-3 text-lg text-[var(--fg-muted)]">{pm(locale, 'problem.intro')}</p>
    </header>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        four.map((n) => (
          <li class="reveal card p-6">
            <h3 class="text-base font-semibold">{pm(locale, `problem.${n}.title` as const)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">
              {pm(locale, `problem.${n}.body` as const)}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="reveal text-3xl font-bold tracking-tight sm:text-4xl">{pm(locale, 'how.title')}</h2>
    <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        four.map((n) => (
          <li class="reveal card p-6">
            <span class="ai-gradient-bg inline-flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold text-white" aria-hidden="true">
              {n}
            </span>
            <h3 class="mt-3 text-base font-semibold">{pm(locale, `how.${n}.title` as const)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">
              {pm(locale, `how.${n}.body` as const)}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <header class="reveal max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{pm(locale, 'lenses.title')}</h2>
      <p class="mt-3 text-lg text-[var(--fg-muted)]">{pm(locale, 'lenses.intro')}</p>
    </header>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        four.map((n) => (
          <li class="reveal glass-card p-6">
            <h3 class="text-base font-semibold">{pm(locale, `lenses.${n}.title` as const)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">
              {pm(locale, `lenses.${n}.body` as const)}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <header class="reveal max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{pm(locale, 'breaks.title')}</h2>
      <p class="mt-3 text-lg text-[var(--fg-muted)]">{pm(locale, 'breaks.intro')}</p>
    </header>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        seven.map((n) => (
          <li class="reveal card flex items-start gap-3 p-4 text-sm">
            <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-red-600" aria-hidden="true"></span>
            <span>{pm(locale, `breaks.${n}` as const)}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <header class="reveal max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{pm(locale, 'replace.title')}</h2>
      <p class="mt-3 text-lg text-[var(--fg-muted)]">{pm(locale, 'replace.intro')}</p>
    </header>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        four.map((n) => (
          <li class="reveal card p-4 text-sm font-medium">{pm(locale, `replace.map.${n}` as const)}</li>
        ))
      }
    </ul>
    <div class="reveal glass-card mt-8 p-6">
      <h3 class="text-base font-semibold">{pm(locale, 'replace.rule.title')}</h3>
      <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{pm(locale, 'replace.rule.body')}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="reveal max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">{pm(locale, 'data.title')}</h2>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        four.map((n) => (
          <li class="reveal card p-6">
            <h3 class="text-base font-semibold">{pm(locale, `data.${n}.title` as const)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">
              {pm(locale, `data.${n}.body` as const)}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="reveal max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">{pm(locale, 'paths.title')}</h2>
    <ul class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        three.map((n) => (
          <li class="reveal card p-6">
            <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ai-2)]">
              {pm(locale, `paths.${n}.label` as const)}
            </p>
            <h3 class="mt-2 text-base font-semibold">{pm(locale, `paths.${n}.title` as const)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">
              {pm(locale, `paths.${n}.body` as const)}
            </p>
          </li>
        ))
      }
    </ul>
    <p class="mt-6">
      <a
        href={localePath(locale, locale === 'fr' ? 'docs/cartographie-processus' : 'docs/process-map')}
        class="text-sm font-semibold text-[var(--color-ai-2)] underline underline-offset-4"
      >
        {pm(locale, 'paths.cta')}
      </a>
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <div class="reveal card p-6 sm:p-8">
      <h2 class="text-2xl font-bold tracking-tight">{pm(locale, 'plan.title')}</h2>
      <p class="mt-2 text-[var(--fg-muted)]">{pm(locale, 'plan.body')}</p>
      <a
        href={localePath(locale, 'pricing')}
        class="mt-5 inline-block rounded-xl border border-[var(--border-strong)] px-5 py-2.5 text-sm font-semibold transition-colors hover:bg-[var(--bg-subtle)]"
      >
        {pm(locale, 'plan.cta')}
      </a>
    </div>
  </section>

  <Faq locale={locale} />

  <CtaBand locale={locale} />
</Base>
