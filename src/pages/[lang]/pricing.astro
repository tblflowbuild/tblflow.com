---
import Base from '@/layouts/Base.astro';
import PricingTable from '@/components/PricingTable.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import { FAQ } from '@/data/faq';
import { useTranslations } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
import { LOCALES, type Locale } from '@/config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

const meta = {
  title: {
    de: 'TblFlow Preise: Kostenlos, Essential 39 €, Team 119 €',
    en: 'Pricing: Free, Essential €39, Team €119, Enterprise €399+',
    es: 'Precios de TblFlow: Gratis, Esencial 39 €, Equipo 119 €',
    fr: 'Tarifs : Gratuit, Essentiel 39 €, Équipe 119 €, Entreprise',
    it: 'Prezzi TblFlow: Gratuito, Essenziale 39 €, Team 119 €',
    ja: 'TblFlow 料金：Essential €39、チーム €119、Enterprise €399〜',
    ru: 'Тарифы: Essential 39 €, Team 119 €, Enterprise от 399 €',
    tr: 'Fiyatlar: Essential €39, Team €119, Enterprise €399\'dan',
    uk: 'Ціни: Essential 39 €, Team 119 €, Enterprise від 399 €',
    zh: 'TblFlow 价格：免费、Essential €39、团队 €119、企业 €399 起',
  },
  description: {
    de: 'Vier Tarife: Kostenlos (2 Personen, 1 Base), Essential für 39 €/Monat, Team für 119 €/Monat, Enterprise ab 399 €/Monat. Preis pro Team, nicht pro Person.',
    en: 'Four tiers: Free (2 people, 1 base), Essential at €39/month, Team at €119/month, Enterprise from €399/month. Price per team, not per person.',
    es: 'Cuatro planes: Gratis (2 personas, 1 base), Esencial a 39 €/mes, Equipo a 119 €/mes, Enterprise desde 399 €/mes. Precio por equipo, no por persona.',
    fr: 'Quatre paliers : Gratuit (2 personnes, 1 base), Essentiel à 39 €/mois, Équipe à 119 €/mois, Entreprise dès 399 €/mois. Prix par équipe, pas par personne.',
    it: 'Quattro piani: Gratuito (2 persone, 1 base), Essenziale a 39 €/mese, Team a 119 €/mese, Enterprise da 399 €/mese. Prezzo per team, non per persona.',
    ja: '4 つのプラン：無料（2 名、ベース 1）、Essential は月額 €39、チームは月額 €119、Enterprise は月額 €399 から。料金はチーム単位です。',
    ru: 'Четыре тарифа: бесплатный (2 участника, 1 база), Essential за 39 €/месяц, Team за 119 €/месяц, Enterprise от 399 €/месяц. Цена за команду, а не за человека.',
    tr: 'Dört paket: Ücretsiz (2 kişi, 1 base), ayda €39 ile Essential, ayda €119 ile Team, ayda €399\'dan Enterprise. Fiyat kişi başına değil, ekip başına.',
    uk: 'Чотири тарифи: безкоштовний (2 користувачі, 1 база), Essential за 39 €/міс, Team за 119 €/міс, Enterprise від 399 €/міс. Ціна за команду, а не за людину.',
    zh: '四个套餐：免费版（2 位成员、1 个 base）、Essential 每月 €39、团队版每月 €119、企业版每月 €399 起。按团队计价，而非按人头。',
  },
};


/** Pricing-related answers only — a FAQPage should match its page's topic. */
const pricingFaq = FAQ.filter((item) => item.category === 'pricing').map((item) => ({
  question: item.question[locale],
  answer: item.answer[locale],
}));

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: localePath(locale) },
  { name: t('pricing.title'), path: localePath(locale, 'pricing') },
];
---

<Base
  locale={locale}
  title={meta.title[locale]}
  description={meta.description[locale]}
  path={localePath(locale, 'pricing')}
  breadcrumbs={breadcrumbs}
  faq={pricingFaq}
  product
>
  <div class="mx-auto max-w-6xl px-4 pt-16 text-center sm:px-6 sm:pt-24">
    <h1 class="animate-enter text-4xl font-medium sm:text-5xl">
      {t('pricing.title')}
    </h1>
    <p class="animate-enter delay-1 mx-auto mt-4 max-w-2xl text-lg text-[var(--fg-muted)]">
      {t('pricing.subtitle')}
    </p>
  </div>

  <PricingTable locale={locale} showQuotas />

  <Faq locale={locale} />

  <CtaBand locale={locale} />
</Base>
