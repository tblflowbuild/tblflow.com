---
/**
 * One page per competitor: `/{lang}/compare/{competitor}`.
 *
 * Same skeleton on every page — heading, verdict, full table, differences,
 * where the other tool wins, CTA — because a visitor comparing two products
 * should not have to relearn the layout on each one, and a consistent shape is
 * what lets an answer engine lift the same fields across all four.
 *
 * The slug is a proper noun and therefore identical in both locales, so the
 * hreflang pair resolves without a translation key.
 */
import Base from '@/layouts/Base.astro';
import CtaBand from '@/components/CtaBand.astro';
import { COMPARISON, COMPETITOR_LABELS, type Support } from '@/data/content';
import { COMPETITOR_PAGES, COMPETITOR_SLUGS, type CompetitorSlug } from '@/data/competitors';
import { useTranslations } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
import { LOCALES, type Locale } from '@/config';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    COMPETITOR_SLUGS.map((competitor) => ({ params: { lang, competitor } }))
  );
}

const locale = Astro.params.lang as Locale;
const slug = Astro.params.competitor as CompetitorSlug;
const t = useTranslations(locale);

const page = COMPETITOR_PAGES[slug];
const rival = COMPETITOR_LABELS[slug];
const path = localePath(locale, `compare/${slug}`);

const supportLabel: Record<Support, string> = {
  yes: t('compare.yes'),
  no: t('compare.no'),
  partial: t('compare.partial'),
};

/** Rows where the two products actually differ, surfaced first in the copy. */
const decisive = COMPARISON.filter((row) => row.tblflow === 'yes' && row[slug] !== 'yes');

const year = new Date().getFullYear();
const n = COMPARISON.length;
const d = decisive.length;

/** All ten locales; the interpolated rival name and counts are the same
 * everywhere, only the sentence around them changes. */
const metaSource: Record<Locale, Record<string, string>> = {
  de: {
    title: `TblFlow vs ${rival} — vollständiger Vergleich (${year})`,
    description: `Ausführlicher Vergleich von TblFlow und ${rival}: ${n} Kriterien, die inhaltlichen Unterschiede und die Fälle, in denen ${rival} die bessere Wahl bleibt.`,
    h1: `TblFlow vs ${rival}`,
    tableTitle: `Alle ${n} Kriterien nebeneinander`,
    tableLede: `Jede Zeile ist in beiden Produkten überprüfbar. ${d} Kriterien trennen TblFlow von ${rival}.`,
    diffTitle: 'Was die Tabelle nicht sagt',
    honestTitle: `Wann ${rival} statt TblFlow zu wählen ist`,
    honestLede: 'Kein Produkt gewinnt überall. Hier ist dieses die bessere Wahl.',
    back: 'Alle Vergleiche',
    feature: t('compare.feature'),
  },
  en: {
    title: `TblFlow vs ${rival} — full comparison (${year})`,
    description: `A detailed comparison of TblFlow and ${rival}: ${n} criteria, the substantive differences, and where ${rival} is still the better choice.`,
    h1: `TblFlow vs ${rival}`,
    tableTitle: `All ${n} criteria, side by side`,
    tableLede: `Every row is verifiable in both products. ${d} criteria separate TblFlow from ${rival}.`,
    diffTitle: 'What the table does not say',
    honestTitle: `When to choose ${rival} over TblFlow`,
    honestLede: 'No product wins everywhere. Here is where this one is the better call.',
    back: 'All comparisons',
    feature: t('compare.feature'),
  },
  es: {
    title: `TblFlow vs ${rival} — comparativa completa (${year})`,
    description: `Comparativa detallada entre TblFlow y ${rival}: ${n} criterios, las diferencias de fondo y los casos en los que ${rival} sigue siendo la mejor opción.`,
    h1: `TblFlow vs ${rival}`,
    tableTitle: `Los ${n} criterios, uno al lado del otro`,
    tableLede: `Cada fila es verificable en ambos productos. ${d} criterios separan TblFlow de ${rival}.`,
    diffTitle: 'Lo que la tabla no dice',
    honestTitle: `Cuándo elegir ${rival} en lugar de TblFlow`,
    honestLede: 'Ningún producto gana en todo. Aquí es donde este es la mejor opción.',
    back: 'Todas las comparativas',
    feature: t('compare.feature'),
  },
  fr: {
    title: `TblFlow vs ${rival} — comparatif complet (${year})`,
    description: `Comparatif détaillé entre TblFlow et ${rival} : ${n} critères, différences de fond, et les cas où ${rival} reste le meilleur choix.`,
    h1: `TblFlow vs ${rival}`,
    tableTitle: `Les ${n} critères, côte à côte`,
    tableLede: `Chaque ligne est vérifiable dans les deux produits. ${d} critères séparent TblFlow de ${rival}.`,
    diffTitle: 'Ce que le tableau ne dit pas',
    honestTitle: `Quand choisir ${rival} plutôt que TblFlow`,
    honestLede: 'Aucun produit ne gagne partout. Voici où celui-ci est le meilleur choix.',
    back: 'Tous les comparatifs',
    feature: t('compare.feature'),
  },
  it: {
    title: `TblFlow vs ${rival} — confronto completo (${year})`,
    description: `Confronto dettagliato tra TblFlow e ${rival}: ${n} criteri, le differenze sostanziali e i casi in cui ${rival} resta la scelta migliore.`,
    h1: `TblFlow vs ${rival}`,
    tableTitle: `Tutti i ${n} criteri, uno accanto all’altro`,
    tableLede: `Ogni riga è verificabile in entrambi i prodotti. ${d} criteri separano TblFlow da ${rival}.`,
    diffTitle: 'Ciò che la tabella non dice',
    honestTitle: `Quando scegliere ${rival} invece di TblFlow`,
    honestLede: 'Nessun prodotto vince ovunque. Ecco dove questo è la scelta migliore.',
    back: 'Tutti i confronti',
    feature: t('compare.feature'),
  },
  ja: {
    title: `TblFlow と ${rival} の比較 — 完全版（${year}）`,
    description: `TblFlow と ${rival} の詳細比較：${n} の評価軸、本質的な違い、そして ${rival} のほうが適している場面。`,
    h1: `TblFlow と ${rival}`,
    tableTitle: `${n} の評価軸を並べて比較`,
    tableLede: `どの行も両方の製品で確認できます。${d} の評価軸が TblFlow と ${rival} を分けます。`,
    diffTitle: '表には表れないこと',
    honestTitle: `TblFlow ではなく ${rival} を選ぶべきとき`,
    honestLede: 'すべてで勝る製品はありません。こちらのほうが適している場面を挙げます。',
    back: 'すべての比較',
    feature: t('compare.feature'),
  },
  ru: {
    title: `TblFlow против ${rival} — полное сравнение (${year})`,
    description: `Подробное сравнение TblFlow и ${rival}: ${n} критериев, содержательные различия и случаи, где ${rival} остаётся лучшим выбором.`,
    h1: `TblFlow против ${rival}`,
    tableTitle: `Все ${n} критериев, рядом`,
    tableLede: `Каждую строку можно проверить в обоих продуктах. ${d} критериев отделяют TblFlow от ${rival}.`,
    diffTitle: 'Чего таблица не говорит',
    honestTitle: `Когда выбрать ${rival}, а не TblFlow`,
    honestLede: 'Ни один продукт не выигрывает во всём. Вот где лучше этот.',
    back: 'Все сравнения',
    feature: t('compare.feature'),
  },
  tr: {
    title: `TblFlow ve ${rival} — tam karşılaştırma (${year})`,
    description: `TblFlow ile ${rival} arasında ayrıntılı karşılaştırma: ${n} ölçüt, esas farklar ve ${rival} seçeneğinin hâlâ daha iyi olduğu durumlar.`,
    h1: `TblFlow ve ${rival}`,
    tableTitle: `${n} ölçütün tamamı, yan yana`,
    tableLede: `Her satır iki üründe de doğrulanabilir. ${d} ölçüt TblFlow ile ${rival} arasını ayırıyor.`,
    diffTitle: 'Tablonun söylemedikleri',
    honestTitle: `TblFlow yerine ne zaman ${rival} seçilmeli`,
    honestLede: 'Hiçbir ürün her alanda kazanmaz. İşte bunun daha iyi olduğu yerler.',
    back: 'Tüm karşılaştırmalar',
    feature: t('compare.feature'),
  },
  uk: {
    title: `TblFlow проти ${rival} — повне порівняння (${year})`,
    description: `Докладне порівняння TblFlow і ${rival}: ${n} критеріїв, змістовні відмінності та випадки, де ${rival} лишається кращим вибором.`,
    h1: `TblFlow проти ${rival}`,
    tableTitle: `Усі ${n} критеріїв, поруч`,
    tableLede: `Кожен рядок можна перевірити в обох продуктах. ${d} критеріїв відділяють TblFlow від ${rival}.`,
    diffTitle: 'Чого таблиця не каже',
    honestTitle: `Коли обрати ${rival}, а не TblFlow`,
    honestLede: 'Жоден продукт не виграє в усьому. Ось де кращий саме цей.',
    back: 'Усі порівняння',
    feature: t('compare.feature'),
  },
  zh: {
    title: `TblFlow 对比 ${rival} — 完整对照（${year}）`,
    description: `TblFlow 与 ${rival} 的详细对比：${n} 项标准、实质差异，以及 ${rival} 仍是更优选择的场景。`,
    h1: `TblFlow 对比 ${rival}`,
    tableTitle: `${n} 项标准，逐条并列`,
    tableLede: `每一行都能在两个产品中验证。有 ${d} 项标准把 TblFlow 和 ${rival} 区分开。`,
    diffTitle: '表格没说的部分',
    honestTitle: `什么时候该选 ${rival} 而不是 TblFlow`,
    honestLede: '没有哪个产品能在所有方面取胜。以下是它更合适的场景。',
    back: '全部对比',
    feature: t('compare.feature'),
  },
};

const meta = metaSource[locale];

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: localePath(locale) },
  { name: t('compare.title'), path: localePath(locale, 'compare') },
  { name: meta.h1, path },
];
---

<Base
  locale={locale}
  title={meta.title}
  description={meta.description}
  path={path}
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-4xl px-4 pt-16 sm:px-6 sm:pt-20">
    <a
      href={localePath(locale, 'compare')}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--fg-muted)] transition-colors hover:text-[var(--fg)]"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M19 12H5M11 18l-6-6 6-6"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      {meta.back}
    </a>

    <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl">{meta.h1}</h1>

    {/* The answer first, in one paragraph. A comparison page that makes the
        reader scroll to a table before telling them anything gets abandoned,
        and gives an answer engine nothing short enough to quote. */}
    <p class="mt-5 text-lg leading-relaxed text-[var(--fg-muted)]">{page.summary[locale]}</p>
  </div>

  <section class="mx-auto max-w-4xl scroll-mt-24 px-4 py-16 sm:px-6" id="table">
    <h2 class="reveal text-2xl font-bold tracking-tight sm:text-3xl">{meta.tableTitle}</h2>
    <p class="reveal mt-3 text-[var(--fg-muted)]">{meta.tableLede}</p>

    {/* Horizontal scroll stays inside this container, so the page body never
        scrolls sideways. */}
    <div class="reveal mt-8 overflow-x-auto">
      <table class="w-full min-w-[34rem] border-collapse text-sm">
        <caption class="sr-only-focusable absolute">{meta.title}</caption>
        <thead>
          <tr class="border-b border-[var(--border-strong)] text-left">
            <th scope="col" class="py-3 pr-4 font-semibold">{meta.feature}</th>
            <th scope="col" class="px-4 py-3 font-semibold">TblFlow</th>
            <th scope="col" class="px-4 py-3 font-semibold">{rival}</th>
          </tr>
        </thead>
        <tbody>
          {
            COMPARISON.map((row) => {
              const mine = row.tblflow as Support;
              const theirs = row[slug] as Support;
              const differs = mine !== theirs;
              return (
                <tr
                  class:list={[
                    'border-b border-[var(--border)]',
                    differs && 'bg-[color-mix(in_oklab,var(--color-ai-2)_5%,transparent)]',
                  ]}
                >
                  <th scope="row" class="py-3 pr-4 text-left font-normal">
                    {row.feature[locale]}
                  </th>
                  {[mine, theirs].map((value) => (
                    <td class="px-4 py-3">
                      {/* Glyph aria-hidden, label visible: an icon-only cell
                          transcribes as nothing at all. */}
                      <span
                        class:list={[
                          'inline-flex items-center gap-1.5',
                          value === 'yes' && 'text-[var(--color-ai-3)]',
                          value === 'no' && 'text-[var(--fg-subtle)]',
                        ]}
                      >
                        <span aria-hidden="true">
                          {value === 'yes' ? '✓' : value === 'no' ? '✗' : '~'}
                        </span>
                        {supportLabel[value]}
                      </span>
                    </td>
                  ))}
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-16 sm:px-6">
    <h2 class="reveal text-2xl font-bold tracking-tight sm:text-3xl">{meta.diffTitle}</h2>

    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        page.differences.map((diff) => (
          <div class="reveal card p-6">
            <h3 class="text-base font-semibold">{diff.title[locale]}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{diff.body[locale]}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* Naming where the rival wins is what makes the rest of the page credible —
      to a reader and to an engine weighing whether this is a comparison or an
      advert. */}
  <section class="mx-auto max-w-4xl px-4 pb-20 sm:px-6">
    <div class="reveal card p-7 sm:p-9">
      <h2 class="text-2xl font-bold tracking-tight">{meta.honestTitle}</h2>
      <p class="mt-2 text-sm text-[var(--fg-subtle)]">{meta.honestLede}</p>
      <p class="mt-5 leading-relaxed text-[var(--fg-muted)]">{page.honest[locale]}</p>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>
