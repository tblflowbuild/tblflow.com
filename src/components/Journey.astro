---
/**
 * The home page story, in the order a company lives it: the problem, then
 * understand, map, build, automate, hand to agents, give time back. Each step
 * is one section with a numbered plan mark, its text on one side and a small
 * coded view of the product on the other, so the page reads top to bottom as
 * a timeline. Then what the customer keeps whatever happens.
 *
 * Each step shows a reproduction of the real TblFlow screen it describes,
 * with fictional data, animated on scroll (see scenes/ProductScene.astro and
 * scripts/scenes.ts).
 */
import ProductScene from './scenes/ProductScene.astro';
import { JOURNEY } from '@/data/journey';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = JOURNEY[locale];
const mark = (i: number) => String(i + 1).padStart(2, '0');
/** Steps whose screen is wide in the app (the map canvas): text above, screen full width. */
const WIDE = [0, 2];
---

<div id="parcours">
  {
    copy.steps.map((step, i) => (
      <section class="border-t border-[var(--border)]" aria-labelledby={`etape-${i + 1}`} data-reveal>
        <div class="step-track relative mx-auto grid max-w-6xl gap-10 py-16 pr-4 sm:py-20 sm:pr-6 lg:grid-cols-12 lg:items-center lg:gap-12">
          <span class="step-rail" aria-hidden="true"></span>
          <div class:list={[WIDE.includes(i) ? 'lg:col-span-8' : 'lg:col-span-5']}>
            <p class="step-mark rv font-mono text-sm text-[var(--fg-subtle)] tabular-nums">
              {mark(i)} · {step.label}
            </p>
            <h2 id={`etape-${i + 1}`} class="rv mt-3 text-3xl font-medium sm:text-4xl" style="--d:80">
              {step.title}
            </h2>
            <p class="rv mt-4 text-lg text-[var(--fg-muted)]" style="--d:160">{step.body}</p>
          </div>

          <div class:list={[WIDE.includes(i) ? 'lg:col-span-12' : 'lg:col-span-7']}>
            <ProductScene locale={locale} step={i} />
          </div>
        </div>
      </section>
    ))
  }

  {/* What stays with the customer, whatever the step: the three refusals. */}
  <section class="border-t border-[var(--border)]" aria-labelledby="ce-que-vous-gardez">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 id="ce-que-vous-gardez" class="text-3xl font-medium sm:text-4xl">{copy.keep.title}</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {
          copy.keep.items.map((item) => (
            <li class="border-t border-[var(--border-strong)] pt-4">
              <h3 class="text-base font-medium">{item.title}</h3>
              <p class="mt-2 text-[var(--fg-muted)]">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</div>

<script>
  import '@/scripts/scenes';
</script>
