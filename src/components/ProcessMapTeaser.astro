---
import { pm } from '@/data/processMap';
import { localePath } from '@/i18n/utils';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const paths = [1, 2, 3] as const;
---

<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <header class="reveal max-w-2xl">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{pm(locale, 'home.teaser.title')}</h2>
    <p class="mt-3 text-lg text-[var(--fg-muted)]">{pm(locale, 'home.teaser.body')}</p>
  </header>

  <ul class="mt-10 grid gap-6 sm:grid-cols-3">
    {
      paths.map((n) => (
        <li class="reveal card p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ai-2)]">
            {pm(locale, `paths.${n}.label` as const)}
          </p>
          <h3 class="mt-2 text-base font-semibold">{pm(locale, `paths.${n}.title` as const)}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">
            {pm(locale, `paths.${n}.body` as const)}
          </p>
        </li>
      ))
    }
  </ul>

  <figure class="reveal mx-auto mt-10 max-w-5xl">
    <img
      src="/images/process-map/data-fr-dark.webp"
      alt={pm(locale, 'shot2.alt')}
      width="1600"
      height="942"
      loading="lazy"
      class="card h-auto w-full"
    />
    <figcaption class="mt-3 text-center text-sm text-[var(--fg-subtle)]">
      {pm(locale, 'shot.caption')}
    </figcaption>
  </figure>

  <a
    href={localePath(locale, 'process-map')}
    class="mt-8 inline-block rounded-xl border border-[var(--border-strong)] px-6 py-3 text-base font-semibold transition-colors hover:bg-[var(--bg-subtle)]"
  >
    {pm(locale, 'home.teaser.cta')}
  </a>
</section>
