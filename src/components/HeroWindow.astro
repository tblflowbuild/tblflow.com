---
/**
 * The product window under the hero: one TblFlow process map in two states,
 * before and after TblFlow. A switch in the window's toolbar flips it; the
 * cards stay where they are and change in place (executor stripe, icon,
 * subtitle), the re-keyings turn into plain links and the banner swaps cost
 * for gain. The app's own theme and labels (app-ui.css, appUi.ts).
 *
 * The switch is two native radio buttons, so it works with a click or the
 * arrow keys and needs no script; scenes.ts only plays it on its own. The
 * radios sit before the window because CSS can only look forward. Without
 * script the window shows the "after" state, the one the page argues for.
 *
 * Same fictional story and figures as the journey (heroDemo.ts).
 */
import { hm } from '@/data/home';
import { APP_UI, fill } from '@/data/appUi';
import { APP_ICON as ICON } from '@/data/appIcons';
import { HERO_DEMO_FIGURES as FIG, HERO_DEMO_TOOLS } from '@/data/heroDemo';
import { formatPrice, type Locale } from '@/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = APP_UI[locale];

const SWITCH: Record<Locale, [before: string, after: string]> = {
  de: ['Ohne TblFlow', 'Mit TblFlow'],
  en: ['Without TblFlow', 'With TblFlow'],
  es: ['Sin TblFlow', 'Con TblFlow'],
  fr: ['Sans TblFlow', 'Avec TblFlow'],
  it: ['Senza TblFlow', 'Con TblFlow'],
  ja: ['TblFlow なし', 'TblFlow あり'],
  ru: ['Без TblFlow', 'С TblFlow'],
  tr: ['TblFlow olmadan', 'TblFlow ile'],
  uk: ['Без TblFlow', 'З TblFlow'],
  zh: ['使用 TblFlow 前', '使用 TblFlow 后'],
};
const [beforeLabel, afterLabel] = SWITCH[locale];

const perMonth = (amount: number) => fill(ui.perMonth, { amount: formatPrice(locale, amount) });

/** After TblFlow: the quote stays human, the order is automated, the invoice goes to an agent. */
const STEPS = [
  { n: 1 as const, exec: undefined, icon: ICON.user, after: `${ui.human} · ${ui.entry}` },
  { n: 2 as const, exec: 'var(--tf-automation)', icon: ICON.zap, after: ui.automation },
  { n: 3 as const, exec: 'var(--tf-agent)', icon: ICON.bot, after: ui.agent },
];
---

<div class="hw">
  <input type="radio" name="hero-window" id="hw-before" class="hw-radio sr-only" />
  <input type="radio" name="hero-window" id="hw-after" class="hw-radio sr-only" checked />

  <div class="hw-window tf-app text-left">
    <div class="tf-top">
      <span class="tf-pill hidden sm:inline-flex" aria-hidden="true"><b>TblFlow</b></span>
      <div class="tf-pill gap-1 px-1">
        <label for="hw-before" class="hw-tab">{beforeLabel}</label>
        <label for="hw-after" class="hw-tab">{afterLabel}</label>
      </div>
    </div>

    <div class="hw-stage tf-canvas">
      {/* Banner: cost and ruptures before, gain and coverage after. */}
      <div class="grid gap-2 sm:max-w-2xl sm:grid-cols-3">
        <div class="tf-kpi sc-stack">
          <div class="hw-b">
            <p class="tf-kpi__label">{ui.cost}</p>
            <p class="tf-kpi__value">{perMonth(FIG.monthlyCost)}</p>
          </div>
          <div class="hw-a">
            <p class="tf-kpi__label">{ui.realized}</p>
            <p class="tf-kpi__value text-[var(--tf-positive)]">{perMonth(FIG.realized)}</p>
          </div>
        </div>
        <div class="tf-kpi">
          <p class="tf-kpi__label">{ui.ruptures}</p>
          <p class="tf-kpi__value sc-stack">
            <span class="hw-b text-[var(--tf-destructive)]">2</span>
            <span class="hw-a">0</span>
          </p>
        </div>
        <div class="tf-kpi">
          <p class="tf-kpi__label">{ui.covered}</p>
          <p class="tf-kpi__value sc-stack">
            <span class="hw-b">0 %</span>
            <span class="hw-a">{FIG.covered} %</span>
          </p>
        </div>
      </div>

      {/* The same three steps; links and cards change in place. */}
      <ol class="mt-8 flex flex-col items-stretch md:flex-row md:items-center">
        {
          STEPS.map((step, i) => (
            <>
              {i > 0 && (
                <li class="relative flex h-12 items-center justify-center md:h-auto md:w-28 md:flex-none">
                  <span class="hw-b absolute inset-0 flex items-center justify-center" aria-hidden="true">
                    <span class="block h-full border-l-[1.5px] border-dashed border-[var(--tf-destructive)] md:h-0 md:w-full md:border-t-[1.5px] md:border-l-0"></span>
                  </span>
                  <span class="hw-a absolute inset-0 flex items-center justify-center" aria-hidden="true">
                    <span class="block h-full border-l-[1.25px] border-[var(--tf-muted)] md:h-0 md:w-full md:border-t-[1.25px] md:border-l-0"></span>
                  </span>
                  <span class="hw-b relative bg-[var(--tf-bg)] px-1 text-xs text-[var(--tf-destructive)] md:absolute md:-top-5">
                    {hm(locale, 'example.break')}
                  </span>
                </li>
              )}
              <li class="tf-step hw-step md:flex-1" style={step.exec ? `--exec:${step.exec}` : undefined}>
                <span class="tf-step__icon sc-stack" aria-hidden="true">
                  <svg class="hw-b" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d={ICON.user} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <svg class="hw-a" width="16" height="16" viewBox="0 0 24 24" fill="none"><path d={step.icon} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <span class="min-w-0">
                  <span class="block font-semibold">{hm(locale, `example.step${step.n}.title` as const)}</span>
                  <span class="sc-stack text-xs tf-muted">
                    <span class="hw-b">
                      {ui.human} · {ui.entry}
                      <span class="mt-1 flex items-center gap-1">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={ICON.wrench} stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
                        {HERO_DEMO_TOOLS[i]}
                      </span>
                    </span>
                    <span class="hw-a">{step.after}</span>
                  </span>
                </span>
                {i > 0 && <span class="tf-step__badge hw-b" aria-hidden="true">1</span>}
              </li>
            </>
          ))
        }
      </ol>
    </div>
  </div>
</div>
