---
import type { Feature } from '@/data/content';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
  id: string;
  title: string;
  subtitle: string;
  items: Feature[];
  /** The "staged" treatment — dot-grid backdrop, corner ticks, glass cards —
   * reserved for the section that argues *why* TblFlow, so it reads as a
   * deliberate high point rather than losing its effect through repetition. */
  moody?: boolean;
}

/* Two columns only: the sole remaining caller is the "why" (differentiators)
   section, whose longer copy needs the room. The three-column, short-blurb
   variant this used to also support went with the "features" section it
   served, replaced by SurfacesGrid.astro's illustrated cards. */
const { locale, id, title, subtitle, items, moody = false } = Astro.props;
---

<section
  id={id}
  class:list={[
    'relative mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-6',
    moody && 'corner-ticks',
  ]}
  style={moody ? '--tick: 1.25rem;' : undefined}
>
  {/* No local grid/glow here any more — the page-wide layer in Base.astro
      already supplies both, continuously, behind this section and its
      neighbours. `moody` now marks this section with corner ticks and glass
      cards only, which is enough to still read as the staged one. */}

  <header class="reveal max-w-2xl">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
    <p class="mt-3 text-lg text-[var(--fg-muted)]">{subtitle}</p>
  </header>

  <ul class="mt-12 grid gap-6 sm:grid-cols-2">
    {
      items.map((item) => (
        <li
          class:list={[
            'reveal group p-6 transition-shadow hover:shadow-lg',
            moody ? 'glass-card' : 'card',
          ]}
        >
          <div
            class="ai-gradient-bg inline-flex h-10 w-10 items-center justify-center rounded-lg text-white transition-transform duration-300 group-hover:scale-110"
            aria-hidden="true"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path
                d={item.icon}
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
          <h3 class="mt-4 text-base font-semibold">{item.title[locale]}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{item.body[locale]}</p>
        </li>
      ))
    }
  </ul>
</section>
