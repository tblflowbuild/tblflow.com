---
/**
 * One line and one card on the home page, pointing at /mcp. Deliberately not a
 * section of its own: the MCP server is an integration, and the page it links to
 * carries the detail.
 */
import { mcp } from '@/data/mcp';
import { localePath } from '@/i18n/utils';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6">
  <div class="reveal flex flex-col items-center gap-4 text-center">
    <p class="text-sm font-medium text-[var(--fg-muted)]">{mcp(locale, 'home.line')}</p>
    <a
      href={localePath(locale, 'mcp')}
      class="card group block max-w-md px-6 py-5 text-left transition-colors hover:border-[var(--border-strong)]"
    >
      <p class="text-base font-semibold">{mcp(locale, 'home.card.title')}</p>
      <p class="mt-1 text-sm leading-relaxed text-[var(--fg-muted)]">{mcp(locale, 'home.card.body')}</p>
      <p class="mt-3 text-sm font-semibold text-[var(--color-ai-2)] underline underline-offset-4">
        {mcp(locale, 'home.card.cta')}
      </p>
    </a>
  </div>
</section>
