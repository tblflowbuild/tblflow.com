---
/**
 * Everything that goes in <head>, in one place.
 *
 * Consolidated deliberately: canonical URLs, hreflang alternates and Open Graph
 * tags only work if they agree with each other, and the reliable way to keep them
 * agreeing is to derive them all from the same two inputs (the current URL and
 * the page's own metadata) rather than let each page hand-roll its tags.
 */
import { absoluteUrl, alternateLinks } from '@/i18n/utils';
import { HREFLANG, type Locale } from '@/config';
import '@/styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of the page, locale-prefixed, e.g. `/fr/pricing`. */
  path: string;
  /** Social preview image, absolute or root-relative. */
  image?: string;
  /** `article` for blog posts, `website` otherwise — drives OG parsing. */
  ogType?: 'website' | 'article';
  /** Keeps a page out of search indexes (used by 404). */
  noindex?: boolean;
  publishedAt?: Date;
  updatedAt?: Date;
}

const {
  locale,
  title,
  description,
  path,
  image = '/images/og-default.png',
  ogType = 'website',
  noindex = false,
  publishedAt,
  updatedAt,
} = Astro.props;

const canonical = absoluteUrl(path);
const alternates = alternateLinks(path);
const ogImage = absoluteUrl(image);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />

{/* One canonical per page, absolute. Relative canonicals are silently ignored
    by some crawlers, which is worse than having none. */}
<link rel="canonical" href={canonical} />

{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

{/* hreflang: every locale, plus x-default, and each page points at itself too —
    a self-referencing alternate is required for the set to validate. */}
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="TblFlow" />
<meta property="og:locale" content={HREFLANG[locale].replace('-', '_')} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<link rel="icon" type="image/svg+xml" href="/images/tblflow-logo.svg" />
<link rel="apple-touch-icon" href="/images/tblflow-logo.svg" />
<meta name="theme-color" content="#4f46e5" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`TblFlow — ${locale.toUpperCase()}`}
  href={absoluteUrl(`/${locale}/rss.xml`)}
/>

{/* Self-hosted system font stack, so there is nothing to preconnect to and no
    font file on the critical path. */}
