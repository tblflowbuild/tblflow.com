---
/**
 * Competitive comparison as a real, semantic <table>.
 *
 * The markup choices here are the point of the component:
 *  - `scope="col"` / `scope="row"` so assistive tech (and crawlers) can say which
 *    value belongs to which product and which feature. A grid of divs conveys
 *    none of that.
 *  - A visible text label next to every ✓/✗ glyph, with the glyph itself
 *    aria-hidden. Icon-only cells read as "image image image" to a screen reader,
 *    and generative engines transcribe them as nothing at all.
 *  - A <caption>, which gives the table a name in the accessibility tree.
 * Comparison tables are among the structures answer engines quote most readily,
 * but only when the markup states the relationships instead of implying them
 * visually.
 */
import { COMPARISON, COMPARISON_NOTES, COMPETITORS, COMPETITOR_LABELS, type Support } from '@/data/content';
import { useTranslations } from '@/i18n/ui';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
  title: string;
  subtitle: string;
}

const { locale, title, subtitle } = Astro.props;
const t = useTranslations(locale);

const supportLabel: Record<Support, string> = {
  yes: t('compare.yes'),
  no: t('compare.no'),
  partial: t('compare.partial'),
};
---

<section id="comparison" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-6">
  <header class="reveal max-w-2xl">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
    <p class="mt-3 text-lg text-[var(--fg-muted)]">{subtitle}</p>
  </header>

  {/* Horizontal scroll is contained here, so the page body never scrolls sideways. */}
  <div class="reveal mt-10 overflow-x-auto">
    <table class="w-full min-w-[46rem] border-collapse text-sm">
      <caption class="sr-only-focusable absolute">
        {title} — TblFlow, Airtable, Monday.com, Notion, Salesforce
      </caption>
      <thead>
        <tr class="border-b border-[var(--border-strong)]">
          <th scope="col" class="py-3 pr-4 text-left font-semibold">{t('compare.feature')}</th>
          {
            COMPETITORS.map((competitor) => (
              <th
                scope="col"
                class:list={[
                  'px-3 py-3 text-center font-semibold whitespace-nowrap',
                  competitor === 'tblflow' && 'ai-gradient-text',
                ]}
              >
                {COMPETITOR_LABELS[competitor]}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          COMPARISON.map((row) => (
            <tr class="border-b border-[var(--border)]">
              <th scope="row" class="py-3 pr-4 text-left font-medium text-[var(--fg-muted)]">
                {row.feature[locale]}
              </th>
              {
                COMPETITORS.map((competitor) => {
                  const value = row[competitor];
                  return (
                    <td
                      class:list={[
                        'px-3 py-3 text-center',
                        competitor === 'tblflow' && 'bg-[var(--bg-subtle)]',
                      ]}
                    >
                      <span class="sr-only-focusable absolute">{supportLabel[value]}</span>
                      {value === 'yes' && (
                        <svg
                          class="mx-auto text-emerald-500"
                          width="18"
                          height="18"
                          viewBox="0 0 24 24"
                          fill="none"
                          aria-hidden="true"
                        >
                          <path
                            d="M20 6 9 17l-5-5"
                            stroke="currentColor"
                            stroke-width="2.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      )}
                      {value === 'no' && (
                        <svg
                          class="mx-auto text-[var(--fg-subtle)] opacity-60"
                          width="18"
                          height="18"
                          viewBox="0 0 24 24"
                          fill="none"
                          aria-hidden="true"
                        >
                          <path
                            d="M18 6 6 18M6 6l12 12"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                          />
                        </svg>
                      )}
                      {value === 'partial' && (
                        <svg
                          class="mx-auto text-amber-500"
                          width="18"
                          height="18"
                          viewBox="0 0 24 24"
                          fill="none"
                          aria-hidden="true"
                        >
                          <path
                            d="M5 12h14"
                            stroke="currentColor"
                            stroke-width="2.4"
                            stroke-linecap="round"
                          />
                        </svg>
                      )}
                    </td>
                  );
                })
              }
            </tr>
          ))
        }

        {
          COMPARISON_NOTES.map((row) => (
            <tr class="border-b border-[var(--border)]">
              <th scope="row" class="py-3 pr-4 text-left font-medium text-[var(--fg-muted)]">
                {row.feature[locale]}
              </th>
              {
                COMPETITORS.map((competitor) => (
                  <td
                    class:list={[
                      'px-3 py-3 text-center whitespace-nowrap',
                      competitor === 'tblflow'
                        ? 'bg-[var(--bg-subtle)] font-semibold'
                        : 'text-[var(--fg-muted)]',
                    ]}
                  >
                    {row.values[competitor][locale]}
                  </td>
                ))
              }
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-4 text-xs text-[var(--fg-subtle)]">
    {
      locale === 'fr'
        ? "Comparatif établi à partir des offres publiques des éditeurs concernés. Les fonctionnalités et tarifs de ces produits évoluent — vérifiez auprès d'eux avant de décider."
        : 'Comparison based on the publicly documented offerings of the vendors named. Their features and pricing change — verify with them before deciding.'
    }
  </p>
</section>
