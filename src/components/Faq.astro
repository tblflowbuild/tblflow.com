---
/**
 * FAQ with search and category filtering — the "Smart FAQ" interaction pattern.
 *
 * Built as progressive enhancement, which matters here more than usual:
 *  - Without JavaScript, every question is present in the HTML and expandable via
 *    native <details>. Nothing is hidden behind a script.
 *  - The search field and category chips are added by the script itself, so a
 *    no-JS visitor never sees controls that would not work.
 * That ordering is also what keeps the content indexable and quotable: crawlers
 * and answer engines read the full answers straight out of the markup rather than
 * having to execute a filter to find them.
 *
 * The answers are rendered here AND emitted as FAQPage structured data by the
 * page that includes this component — same strings, one source in `data/faq.ts`,
 * so the visible text and the structured data cannot drift apart.
 */
import { FAQ, FAQ_CATEGORIES } from '@/data/faq';
import { useTranslations } from '@/i18n/ui';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="faq" class="mx-auto max-w-3xl scroll-mt-24 px-4 py-20 sm:px-6">
  <header class="reveal">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('faq.title')}</h2>
    <p class="mt-3 text-lg text-[var(--fg-muted)]">{t('faq.subtitle')}</p>
  </header>

  <div class="reveal mt-8" data-faq-root>
    {/* Controls are injected here by the script — hidden from no-JS visitors. */}
    <div data-faq-controls hidden>
      <label class="block">
        <span class="sr-only-focusable absolute">{t('faq.search')}</span>
        <input
          type="search"
          data-faq-search
          placeholder={t('faq.search')}
          autocomplete="off"
          class="w-full rounded-xl border border-[var(--border-strong)] bg-[var(--bg-raised)] px-4 py-3 text-sm outline-none focus:border-transparent"
        />
      </label>

      <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label={t('faq.title')}>
        <button
          type="button"
          data-faq-filter="all"
          aria-pressed="true"
          class="rounded-full border border-[var(--border-strong)] px-3 py-1.5 text-xs font-medium transition-colors aria-pressed:bg-[var(--fg)] aria-pressed:text-[var(--bg)]"
        >
          {t('faq.all')}
        </button>
        {
          FAQ_CATEGORIES.map((category) => (
            <button
              type="button"
              data-faq-filter={category.id}
              aria-pressed="false"
              class="rounded-full border border-[var(--border-strong)] px-3 py-1.5 text-xs font-medium transition-colors aria-pressed:bg-[var(--fg)] aria-pressed:text-[var(--bg)]"
            >
              {category.label[locale]}
            </button>
          ))
        }
      </div>
    </div>

    <ul class="mt-6 space-y-3">
      {
        FAQ.map((item) => (
          <li
            class="reveal"
            data-faq-item
            data-faq-category={item.category}
            data-faq-text={`${item.question[locale]} ${item.answer[locale]}`.toLowerCase()}
          >
            <details class="card group px-5 py-4">
              <summary
                class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-medium [&::-webkit-details-marker]:hidden"
              >
                <span>{item.question[locale]}</span>
                <svg
                  class="shrink-0 text-[var(--fg-subtle)] transition-transform duration-200 group-open:rotate-45"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M12 5v14M5 12h14"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-[var(--fg-muted)]">
                {item.answer[locale]}
              </p>
            </details>
          </li>
        ))
      }
    </ul>

    <p data-faq-empty hidden class="mt-6 text-center text-sm text-[var(--fg-subtle)]">
      {t('faq.empty')}
    </p>
  </div>
</section>

<script>
  /**
   * ~40 lines, no framework, no hydration. Runs once per page.
   * `is:inline` is deliberately not used so Astro bundles and minifies it.
   */
  const root = document.querySelector<HTMLElement>('[data-faq-root]');
  if (root) {
    const controls = root.querySelector<HTMLElement>('[data-faq-controls]');
    const search = root.querySelector<HTMLInputElement>('[data-faq-search]');
    const empty = root.querySelector<HTMLElement>('[data-faq-empty]');
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-faq-item]'));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-faq-filter]'));

    // Reveal the controls only now that they are known to work.
    controls?.removeAttribute('hidden');

    let category = 'all';
    let query = '';

    const apply = () => {
      let visible = 0;
      for (const item of items) {
        const matchesCategory =
          category === 'all' || item.dataset.faqCategory === category;
        const matchesQuery =
          query === '' || (item.dataset.faqText ?? '').includes(query);
        const show = matchesCategory && matchesQuery;
        item.hidden = !show;
        if (show) visible++;
      }
      if (empty) empty.hidden = visible > 0;
    };

    search?.addEventListener('input', () => {
      query = (search.value ?? '').trim().toLowerCase();
      apply();
    });

    for (const button of buttons) {
      button.addEventListener('click', () => {
        category = button.dataset.faqFilter ?? 'all';
        for (const other of buttons) {
          other.setAttribute('aria-pressed', String(other === button));
        }
        apply();
      });
    }
  }
</script>
