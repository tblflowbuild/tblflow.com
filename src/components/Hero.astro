---
/**
 * Home introduction, composed as a scene: the isometric mark very large in
 * the background on the left, the app window over its right half and across
 * three quarters of the page, the name and the signature just above the
 * window. No button here: the header's action is enough.
 *
 * The band follows the site theme, and so does the app window, as the app
 * itself does; a bottom rule separates it from the journey.
 * On small screens the mark moves behind the title, dimmed, and the window
 * takes the full width.
 *
 * The title says the result (the promise validated in docs/positionnement.md),
 * the line under it says what the customer keeps, what moves into TblFlow and
 * who validates, and the signature is the one the product proves: the AI
 * prepares, a person approves. The brand name stays above, as a small mark.
 */
import Logo from './Logo.astro';
import HeroTour from './HeroTour.astro';
import { pm } from '@/data/processMap';
import { hm } from '@/data/home';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="intro-dark relative overflow-hidden">
  <div class="relative mx-auto max-w-7xl px-4 pt-12 pb-16 sm:px-6 sm:pt-20 sm:pb-24">
    <div class="intro-mark animate-enter-fade" aria-hidden="true">
      <Logo size={640} animate />
    </div>

    <div class="relative lg:ml-[25%]">
      <p class="animate-enter text-center text-base font-medium text-[var(--fg-muted)] lg:text-left">TblFlow</p>
      <h1 class="animate-enter delay-1 mt-3 text-center text-3xl leading-[1.1] font-medium tracking-[-0.03em] text-balance sm:text-5xl lg:text-6xl lg:text-left">
        {pm(locale, 'home.hero.title')}
      </h1>
      <p class="animate-enter delay-2 mt-5 max-w-3xl text-center text-lg text-balance text-[var(--fg-muted)] sm:text-xl lg:text-left">
        {hm(locale, 'hero.promise')}
      </p>
      <p class="animate-enter delay-2 mt-3 text-center text-base font-medium lg:text-left">
        {hm(locale, 'hero.sign')}
      </p>

      <div class="animate-enter delay-3 mt-10 sm:mt-12">
        <HeroTour locale={locale} />
      </div>
    </div>
  </div>
</section>
