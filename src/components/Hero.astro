---
/**
 * Home introduction, in the manner of a product launch page: the product
 * name, the signature in one line, one action, then a large window of the
 * app whose tabs play on their own. The band is dark whatever the site theme
 * (`.intro-dark`), so the app window sits in its own light; the journey that
 * follows returns to the site theme.
 *
 * What the intro used to say (the re-keying headline, the trial note, the
 * proof figures) now lives in the journey and on the pricing page; the page
 * <title> and description still carry the re-keying promise for search.
 */
import Logo from './Logo.astro';
import HeroWindow from './HeroWindow.astro';
import { useTranslations } from '@/i18n/ui';
import { JOURNEY } from '@/data/journey';
import { SIGNUP_TRIAL_URL, type Locale } from '@/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="intro-dark">
  <div class="mx-auto max-w-4xl px-4 pt-16 text-center sm:px-6 sm:pt-24">
    <h1
      class="animate-enter delay-1 flex items-center justify-center gap-4 text-5xl leading-none font-medium tracking-[-0.03em] sm:gap-5 sm:text-7xl"
    >
      <Logo size={64} animate />
      TblFlow
    </h1>

    <p class="animate-enter delay-2 mx-auto mt-6 max-w-2xl text-lg text-balance text-[var(--fg-muted)] sm:text-xl">
      {JOURNEY[locale].signature}
    </p>

    <a
      href={SIGNUP_TRIAL_URL}
      class="ai-gradient-bg animate-enter delay-3 mt-8 inline-block rounded-lg px-6 py-3 text-base font-medium text-white"
    >
      {t('hero.cta.primary')}
    </a>
  </div>

  {/* The window is wider than the copy column, so it gets its own container. */}
  <div class="animate-enter delay-4 mx-auto max-w-6xl px-4 pt-12 pb-16 sm:px-6 sm:pt-16 sm:pb-24">
    <HeroWindow locale={locale} />
  </div>
</section>
