---
import Logo from './Logo.astro';
import HeroCards from './HeroCards.astro';
import StepsRibbon from './StepsRibbon.astro';
import { useTranslations } from '@/i18n/ui';
import { pm } from '@/data/processMap';
import { hm } from '@/data/home';
import { SIGNUP_TRIAL_URL, type Locale } from '@/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * Proof points sit directly under the CTA rather than further down the page.
 * They speak to an owner or ops lead deciding whether to try it, and each one
 * holds for the plan the CTA leads to: no "millions of rows" next to a free
 * tier capped at 5,000.
 */
const proof = [
  { value: t('proof.deploy.value'), label: t('proof.deploy') },
  { value: hm(locale, 'proof.trial.value'), label: hm(locale, 'proof.trial') },
  { value: hm(locale, 'proof.free.value'), label: hm(locale, 'proof.free') },
  // A word, not a number: one size down so it fits the four-column row.
  { value: 'PostgreSQL', label: hm(locale, 'proof.data'), small: true },
];

---

<section class="corner-ticks relative isolate mx-2 overflow-hidden sm:mx-4" style="--tick: 1.4rem;">
  <div class="mx-auto max-w-4xl px-4 pt-10 text-center sm:px-6 sm:pt-14">
    <div class="animate-enter-fade flex justify-center">
      <Logo size={72} animate title="TblFlow" />
    </div>

    <p class="eyebrow animate-enter delay-1 mt-8 justify-center">
      {t('hero.eyebrow')}
    </p>

    <h1
      class="animate-enter delay-3 mx-auto mt-6 max-w-3xl text-4xl leading-[1.1] font-medium text-balance sm:text-5xl sm:tracking-[-0.02em]"
    >
      {pm(locale, 'home.hero.title')}
    </h1>

    <p
      class="animate-enter delay-4 mx-auto mt-4 max-w-2xl text-base text-[var(--fg-muted)] sm:text-lg"
    >
      {pm(locale, 'home.hero.subtitle')}
    </p>

    {/* Free stays the default action. The trial link sits in the note under
        it, because the process map the H1 promises is a Pro feature: saying
        so here is what keeps the H1 and the button from contradicting each
        other. */}
    <a
      href={SIGNUP_TRIAL_URL}
      class="ai-gradient-bg animate-enter delay-4 mt-9 inline-block rounded-xl px-6 py-3 text-base font-medium text-white"
    >
      {t('hero.cta.primary')}
    </a>

    <p class="animate-enter delay-4 mx-auto mt-4 max-w-xl text-sm text-[var(--fg-subtle)]">
      {hm(locale, 'trial.note')}{' '}
      <a href={SIGNUP_TRIAL_URL} class="font-medium text-[var(--color-ai-2)] hover:underline">
        {hm(locale, 'trial.link')}&nbsp;→
      </a>
    </p>

    <dl
      class="animate-enter delay-4 mx-auto mt-14 grid max-w-2xl grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4"
    >
      {
        /* dt must precede dd in the markup, but the number should read first
           visually — hence the flex-column order swap rather than a duplicated,
           visually-hidden label (which made screen readers announce it twice). */
        proof.map((item) => (
          <div class="flex flex-col">
            <dt class="order-2 mt-1 text-xs text-[var(--fg-subtle)]">{item.label}</dt>
            <dd class:list={['order-1 font-mono font-medium tabular-nums', item.small ? 'text-xl leading-9 sm:text-2xl' : 'text-2xl sm:text-3xl']}>{item.value}</dd>
          </div>
        ))
      }
    </dl>

    {/* Three panels — the table, the agent writing into it, the app it
        publishes to. Replaces the single mockup: one card showed the output,
        the deck shows the chain that produces it. */}
  </div>

  {/* The deck is wider than the copy column. Nested inside it, a child wider
      than its parent stretches the parent's content box and shifts every
      centred element in it — measured at 46px off-centre. So it gets its own
      container instead. */}
  <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="animate-enter delay-4">
      <HeroCards locale={locale} />
    </div>

    <div class="reveal mt-16">
      <StepsRibbon locale={locale} />
    </div>

  </div>
</section>
