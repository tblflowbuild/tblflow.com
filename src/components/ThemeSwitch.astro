---
/**
 * Light/dark toggle.
 *
 * A real `<button role="switch">` rather than a styled div: it is focusable and
 * operable by keyboard for free, and `aria-checked` means the state is
 * announced instead of being conveyed only by a thumb position.
 *
 * Rendered `hidden` and revealed by its own script. Without JavaScript the
 * toggle could not do anything, and a control that visibly does nothing is
 * worse than one that is absent — the same rule the FAQ's filter follows.
 */
import { useTranslations } from '@/i18n/ui';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
const t = useTranslations(locale);
const label = t('theme.toggle');
---

<button
  type="button"
  role="switch"
  aria-checked="false"
  aria-label={label}
  class="theme-switch"
  data-theme-toggle
  hidden
>
  <span class="theme-switch__thumb"></span>

  <svg class="theme-switch__sun" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <circle cx="10" cy="10" r="4" stroke="currentColor" stroke-width="1.6"></circle>
    <path
      d="M10 1.5v1.7M10 16.8v1.7M3.5 3.5l1.2 1.2M15.3 15.3l1.2 1.2M1.5 10h1.7M16.8 10h1.7M3.5 16.5l1.2-1.2M15.3 4.7l1.2-1.2"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"></path>
  </svg>

  <svg class="theme-switch__moon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path
      d="M17.7 9.8a5.4 5.4 0 0 1-7.5-7.5 7.7 7.7 0 1 0 7.5 7.5Z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  /**
   * The stored value is only ever written when the visitor actually picks a
   * theme. Storing the resolved theme on first load instead would freeze
   * whatever the OS happened to be set to that day, and the page would stop
   * following `prefers-color-scheme` from then on.
   */
  const root = document.documentElement;

  const resolved = () =>
    root.dataset.theme ??
    (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.hidden = false;
    button.setAttribute('aria-checked', String(resolved() === 'dark'));

    button.addEventListener('click', () => {
      const next = resolved() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* Storage blocked — the choice still applies for this page view. */
      }
      document
        .querySelectorAll('[data-theme-toggle]')
        .forEach((b) => b.setAttribute('aria-checked', String(next === 'dark')));
    });
  });
</script>
