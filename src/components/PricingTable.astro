---
import { TIERS, QUOTAS, API_RATE_LIMIT_NOTE } from '@/data/pricing';
import { useTranslations } from '@/i18n/ui';
import { SUPPORT_EMAIL, formatPrice, formatMonthlyEquivalent, type Locale } from '@/config';

interface Props {
  locale: Locale;
  /** The full quota grid is worth it on /pricing, too heavy on the home page. */
  showQuotas?: boolean;
}

const { locale, showQuotas = true } = Astro.props;
const t = useTranslations(locale);
---

<section id="pricing" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 sm:px-6" data-billing-root>
  {/*
    Monthly/annual toggle — progressive enhancement, same ~15-line pattern as
    the FAQ/blog filters. Both cycles are real Stripe prices and buyable at
    checkout since 2026-09-01; the annual one is one month free, computed in
    `pricing.ts`.
  */}
  <div class="mb-8 flex flex-col items-center gap-2">
    <div class="inline-flex rounded-full border border-[var(--border-strong)] p-1 text-sm">
      <button
        type="button"
        data-billing-toggle="monthly"
        aria-pressed="true"
        class="rounded-full px-4 py-2 font-medium transition-colors aria-pressed:bg-[var(--fg)] aria-pressed:text-[var(--bg)]"
      >
        {t('pricing.billing.monthly')}
      </button>
      <button
        type="button"
        data-billing-toggle="annual"
        aria-pressed="false"
        class="flex items-center gap-2 rounded-full px-4 py-2 font-medium transition-colors aria-pressed:bg-[var(--fg)] aria-pressed:text-[var(--bg)]"
      >
        {t('pricing.billing.annual')}
        <span class="text-xs font-normal opacity-70">
          {t('pricing.billing.save')}
        </span>
      </button>
    </div>
  </div>

  {/*
    Subgrid, so the four cards align row-by-row — name, tagline, price, CTA and
    feature list each share a baseline across all four. With plain flex columns the
    CTAs sat at four different heights because the taglines wrap to different
    depths, which reads as a layout bug rather than a design choice.
  */}
  <ul class="grid gap-6 lg:grid-cols-4 lg:grid-rows-[auto_auto_auto_auto_1fr]">
    {
      TIERS.map((tier) => (
        <li
          class:list={[
            'card relative flex flex-col p-6 lg:row-span-5 lg:grid lg:grid-rows-subgrid lg:gap-0',
            tier.featured && 'ring-1 ring-[var(--fg-subtle)]',
          ]}
        >
          {tier.featured && (
            <span class="absolute top-6 right-6 text-xs text-[var(--fg-subtle)]">
              {t('pricing.popular')}
            </span>
          )}

          <h3 class="text-lg font-medium">{tier.name[locale]}</h3>
          <p class="mt-1 text-sm text-[var(--fg-muted)]">{tier.tagline[locale]}</p>

          {/* The Free tier shows "$0"/"0 €", not the word "Free" — the tier is
              already named "Free" right above, and a uniform price row
              (0 / 29 / 99 / Custom) is what lets the subgrid align cleanly. */}
          <div class="mt-5">
            {tier.price === null ? (
              <p class="flex items-baseline gap-1">
                <span class="text-3xl font-medium tabular-nums">{t('pricing.custom')}</span>
              </p>
            ) : tier.annualTotal === null ? (
              <p class="flex items-baseline gap-1">
                <span class="text-4xl font-medium tabular-nums">{formatPrice(locale, tier.price)}</span>
                <span class="text-sm text-[var(--fg-subtle)]">{t('pricing.month')}</span>
              </p>
            ) : (
              <>
                <p class="flex items-baseline gap-1" data-billing-price="monthly">
                  <span class="text-4xl font-medium tabular-nums">{formatPrice(locale, tier.price)}</span>
                  <span class="text-sm text-[var(--fg-subtle)]">{t('pricing.month')}</span>
                </p>
                <p class="flex items-baseline gap-1" data-billing-price="annual" hidden>
                  <span class="text-4xl font-medium tabular-nums">
                    {formatMonthlyEquivalent(locale, tier.annualTotal)}
                  </span>
                  <span class="text-sm text-[var(--fg-subtle)]">{t('pricing.month')}</span>
                </p>
                <p class="mt-1 text-xs text-[var(--fg-subtle)]">
                  <span data-billing-caption="monthly">{t('pricing.billing.perMonthMonthly')}</span>
                  <span data-billing-caption="annual" hidden>
                    {t('pricing.billing.perMonthAnnual')} ({formatPrice(locale, tier.annualTotal)}
                    {t('pricing.year')})
                  </span>
                </p>
              </>
            )}
          </div>

          <a
            href={tier.ctaHref}
            class:list={[
              'mt-6 block rounded-lg px-4 py-2 text-center text-sm font-medium transition-colors',
              tier.featured
                ? 'ai-gradient-bg text-white'
                : 'border border-[var(--border-strong)] hover:bg-[var(--bg-subtle)]',
            ]}
          >
            {tier.cta[locale]}
          </a>

          <ul class="mt-6 space-y-3 text-sm">
            {tier.highlights[locale].map((line) => (
              <li class="flex gap-2">
                <svg
                  class="mt-1 shrink-0 text-[var(--fg-subtle)]"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M20 6 9 17l-5-5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span class="text-[var(--fg-muted)]">{line}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>

  {
    showQuotas && (
      <div class="mt-16">
        <h3 class="text-xl font-medium">{t('pricing.compare')}</h3>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[42rem] border-collapse text-sm">
            <caption class="sr-only-focusable absolute">{t('pricing.compare')}</caption>
            <thead>
              <tr class="border-b border-[var(--border-strong)]">
                <th scope="col" class="py-3 pr-4 text-left font-medium" />
                {TIERS.map((tier) => (
                  <th
                    scope="col"
                    class:list={[
                      'px-3 py-3 text-center font-medium whitespace-nowrap',
                    ]}
                  >
                    {tier.name[locale]}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {QUOTAS.map((row) => (
                <tr class="border-b border-[var(--border)]">
                  <th scope="row" class="py-3 pr-4 text-left font-medium text-[var(--fg-muted)]">
                    {row.label[locale]}
                  </th>
                  {TIERS.map((tier) => (
                    <td
                      class:list={[
                        'px-3 py-3 text-center whitespace-nowrap',
                        tier.featured && 'bg-[var(--bg-subtle)] font-medium',
                      ]}
                    >
                      {row.values[tier.id][locale]}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-[var(--fg-subtle)]">{API_RATE_LIMIT_NOTE[locale]}</p>
      </div>
    )
  }

  {/* Self-hosting is the strongest differentiator against every competitor in the
      comparison table, so it gets its own panel rather than a footnote. */}
  <aside class="card mt-12 overflow-hidden p-0">
    <div class="grid gap-6 p-7 sm:grid-cols-[1fr_auto] sm:items-center">
      <div>
        <h3 class="text-lg font-medium">{t('pricing.selfhost.title')}</h3>
        <p class="mt-2 max-w-2xl text-sm text-[var(--fg-muted)]">{t('pricing.selfhost.body')}</p>
      </div>
      <a
        href={`mailto:${SUPPORT_EMAIL}`}
        class="justify-self-start rounded-lg border border-[var(--border-strong)] px-5 py-2 text-sm font-medium whitespace-nowrap transition-colors hover:bg-[var(--bg-subtle)] sm:justify-self-end"
      >
        {t('pricing.selfhost.cta')}
      </a>
    </div>
  </aside>
</section>

<script>
  /** Same small toggle pattern as the FAQ/blog filters — no framework. */
  const root = document.querySelector<HTMLElement>('[data-billing-root]');
  if (root) {
    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-billing-toggle]')
    );

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const cycle = button.dataset.billingToggle;
        for (const other of buttons) {
          other.setAttribute('aria-pressed', String(other === button));
        }
        for (const el of root.querySelectorAll<HTMLElement>('[data-billing-price]')) {
          el.hidden = el.dataset.billingPrice !== cycle;
        }
        for (const el of root.querySelectorAll<HTMLElement>('[data-billing-caption]')) {
          el.hidden = el.dataset.billingCaption !== cycle;
        }
      });
    }
  }
</script>
