---
/**
 * The six platform surfaces, as a small animated diagram each rather than a
 * plain icon-and-blurb card — Tables, Apps & Dashboards, Automations,
 * Knowledge graph, AI Agents, Computer use.
 *
 * Copy comes from `SURFACES` in `@/data/content.ts`, the same source
 * `llms-full.txt` and the JSON-LD read from — only the presentation changed.
 *
 * Every stage animation is `aria-hidden`: it illustrates what the paragraph
 * next to it already says, and CSS animation is muted globally under
 * `prefers-reduced-motion`.
 */
import { SURFACES } from '@/data/content';
import { useTranslations } from '@/i18n/ui';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
const t = useTranslations(locale);
const [tables, apps, automations, knowledgeGraph, agents, computerUse] = SURFACES;
---

<section id="features" class="relative mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-6">
  <header class="reveal mx-auto max-w-2xl text-center">
    <p class="eyebrow justify-center">{t('surfaces.eyebrow')}</p>
    <h2 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">
      {t('surfaces.title')}
    </h2>
    <p class="mt-4 text-lg text-[var(--fg-muted)]">{t('surfaces.subtitle')}</p>
  </header>

  <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {/* 1. Tables — a formula cell lighting up as its source changes. */}
    <li class="reveal card overflow-hidden">
      <div class="sf-stage" aria-hidden="true">
        <div class="sf-tb-grid">
          <div class="sf-tb-cell sf-tb-src"></div>
          <div class="sf-tb-cell sf-tb-src"></div>
          <div class="sf-tb-cell"></div>
          <div class="sf-tb-cell sf-tb-cell--formula sf-tb-target"></div>
          <div class="sf-tb-cell"></div>
          <div class="sf-tb-cell"></div>
          <div class="sf-tb-cell"></div>
          <div class="sf-tb-cell sf-tb-cell--formula"></div>
          <div class="sf-tb-cell"></div>
          <div class="sf-tb-cell"></div>
          <div class="sf-tb-cell"></div>
          <div class="sf-tb-cell sf-tb-cell--formula"></div>
        </div>
        <div class="sf-tb-db">
          <svg viewBox="0 0 24 24">
            <ellipse cx="12" cy="5" rx="8" ry="3"></ellipse>
            <path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"></path>
            <path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"></path>
          </svg>
        </div>
      </div>
      <div class="p-6">
        <h3 class="text-base font-semibold">{tables.title[locale]}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{tables.body[locale]}</p>
      </div>
    </li>

    {/* 2. Apps & Dashboards — widgets assembling, then a visitor lock and API line. */}
    <li class="reveal card overflow-hidden">
      <div class="sf-stage" aria-hidden="true">
        <div class="sf-db-canvas">
          <div class="sf-db-widget sf-db-widget--chart">
            <span style="height:40%"></span><span style="height:70%"></span><span style="height:50%"></span>
            <span style="height:85%"></span><span style="height:60%"></span>
          </div>
          <div class="sf-db-widget sf-db-widget--kpi"><div class="sf-db-kpi-num"></div><div class="sf-db-kpi-label"></div></div>
          <div class="sf-db-widget sf-db-widget--kpi"><div class="sf-db-kpi-num"></div><div class="sf-db-kpi-label"></div></div>
          <div class="sf-db-lock">
            <svg viewBox="0 0 24 24">
              <rect x="5" y="11" width="14" height="9" rx="1.5"></rect>
              <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
            </svg>
          </div>
          <div class="sf-db-api">↕ {t('surfaces.mock.api')}</div>
        </div>
      </div>
      <div class="p-6">
        <h3 class="text-base font-semibold">{apps.title[locale]}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{apps.body[locale]}</p>
      </div>
    </li>

    {/* 3. Automations — a pulse travelling trigger → gate → action. */}
    <li class="reveal card overflow-hidden">
      <div class="sf-stage" aria-hidden="true">
        <div class="sf-au-row">
          <div class="sf-au-nodes">
            <div class="sf-au-node">
              <svg viewBox="0 0 24 24"><path class="fi" d="M13 3 6 13h5l-1 8 8-11h-5l1-7z"></path></svg>
            </div>
            <div class="sf-au-node">
              <svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1"></rect><rect x="13" y="13" width="7" height="7" rx="1"></rect><path d="M11 7.5h4M12.5 11v2"></path></svg>
            </div>
            <div class="sf-au-node sf-au-node--gate">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M8.5 12.5l2.3 2.3L16 9.8"></path></svg>
            </div>
            <div class="sf-au-node">
              <svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1"></rect><rect x="13" y="13" width="7" height="7" rx="1"></rect><path d="M11 7.5h4M12.5 11v2"></path></svg>
            </div>
          </div>
          <div class="sf-au-pulse"></div>
        </div>
      </div>
      <div class="p-6">
        <h3 class="text-base font-semibold">{automations.title[locale]}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{automations.body[locale]}</p>
      </div>
    </li>

    {/* 4. Knowledge graph — a ping radiating from the core, leaves lighting in turn. */}
    <li class="reveal card overflow-hidden">
      <div class="sf-stage" aria-hidden="true">
        <div class="sf-net">
          <div class="sf-net-line" style="width:42.5%; transform:rotate(-138.8deg);"></div>
          <div class="sf-net-line" style="width:43.9%; transform:rotate(-43.2deg);"></div>
          <div class="sf-net-line" style="width:42.4%; transform:rotate(135deg);"></div>
          <div class="sf-net-line" style="width:45.3%; transform:rotate(45deg);"></div>
          <div class="sf-kg-ping"></div>
          <div class="sf-net-node sf-net-node--core">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><line x1="15.5" y1="15.5" x2="20.5" y2="20.5"></line></svg>
          </div>
          {
            [
              ['18%', '22%', '0s'],
              ['82%', '20%', '0.35s'],
              ['20%', '80%', '0.7s'],
              ['82%', '82%', '1.05s'],
            ].map(([left, top, delay]) => (
              <div class="sf-net-node sf-net-node--kg" style={`left:${left}; top:${top}; animation-delay:${delay};`}>
                <svg viewBox="0 0 24 24">
                  <path d="M7 3h7l4 4v14H7z"></path>
                  <line x1="10" y1="12" x2="15" y2="12"></line>
                  <line x1="10" y1="15.5" x2="15" y2="15.5"></line>
                </svg>
              </div>
            ))
          }
        </div>
      </div>
      <div class="p-6">
        <h3 class="text-base font-semibold">{knowledgeGraph.title[locale]}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{knowledgeGraph.body[locale]}</p>
      </div>
    </li>

    {/* 5. AI Agents — a ring turning around the core, pulses out to each tool. */}
    <li class="reveal card overflow-hidden">
      <div class="sf-stage" aria-hidden="true">
        <div class="sf-net">
          <div class="sf-net-line" style="width:42.5%; transform:rotate(-138.8deg);"><div class="sf-net-pulse sf-ag-pulse" style="animation-delay:0s;"></div></div>
          <div class="sf-net-line" style="width:43.9%; transform:rotate(-43.2deg);"><div class="sf-net-pulse sf-ag-pulse" style="animation-delay:1.5s;"></div></div>
          <div class="sf-net-line" style="width:42.4%; transform:rotate(135deg);"><div class="sf-net-pulse sf-ag-pulse" style="animation-delay:3s;"></div></div>
          <div class="sf-net-line" style="width:45.3%; transform:rotate(45deg);"><div class="sf-net-pulse sf-ag-pulse" style="animation-delay:4.5s;"></div></div>
          <div class="sf-ag-ring"></div>
          <div class="sf-net-node sf-net-node--core">
            <svg viewBox="0 0 24 24">
              <path d="M12 2.6v2.6M12 18.8v2.6M2.6 12h2.6M18.8 12h2.6"></path>
              <path style="fill:currentColor;stroke:none" d="M12 7.2 13.6 10.4 16.8 12 13.6 13.6 12 16.8 10.4 13.6 7.2 12 10.4 10.4Z"></path>
            </svg>
          </div>
          <div class="sf-net-node" style="left:18%; top:22%;">
            <svg viewBox="0 0 24 24"><path d="M4 5h16v14H4z"></path><path d="M4 6l8 6 8-6"></path></svg>
          </div>
          <div class="sf-net-node" style="left:82%; top:20%;">
            <svg viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.5"></rect><rect x="13" y="13" width="7" height="7" rx="1.5"></rect><path d="M11 7.5h2.5a2 2 0 0 1 2 2V13"></path></svg>
          </div>
          <div class="sf-net-node" style="left:20%; top:80%;">
            <svg viewBox="0 0 24 24"><path d="M4 19V9.5a2 2 0 0 1 2-2h9l5 5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1Z"></path></svg>
          </div>
          <div class="sf-net-node" style="left:82%; top:82%;">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="1.5"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="8" y1="3" x2="8" y2="6"></line><line x1="16" y1="3" x2="16" y2="6"></line></svg>
          </div>
        </div>
      </div>
      <div class="p-6">
        <h3 class="text-base font-semibold">{agents.title[locale]}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{agents.body[locale]}</p>
      </div>
    </li>

    {/* 6. Computer use — a browser window, a field filling, a cursor clicking through. */}
    <li class="reveal card overflow-hidden">
      <div class="sf-stage" aria-hidden="true">
        <div class="sf-cu-window">
          <div class="sf-cu-chrome">
            <span class="sf-cu-dot"></span><span class="sf-cu-dot"></span><span class="sf-cu-dot"></span>
            <div class="sf-cu-address"></div>
            <span class="sf-cu-rec"></span>
          </div>
          <div class="sf-cu-body">
            <div class="sf-cu-input"><div class="sf-cu-input-fill"></div></div>
            <div class="sf-cu-cursor"><svg viewBox="0 0 16 16"><path d="M2 1l11 5-4.5 1.5L7 12z"></path></svg></div>
            <div class="sf-cu-arrow">→ {t('surfaces.mock.writes')}</div>
          </div>
        </div>
      </div>
      <div class="p-6">
        <h3 class="text-base font-semibold">{computerUse.title[locale]}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--fg-muted)]">{computerUse.body[locale]}</p>
      </div>
    </li>
  </ul>
</section>
