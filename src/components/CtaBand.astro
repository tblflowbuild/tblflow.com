---
import { useTranslations } from '@/i18n/ui';
import { SIGNUP_TRIAL_URL, type Locale } from '@/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div
    class="reveal card relative px-6 py-14 text-center sm:px-14"
  >
    <h2
      class="text-3xl font-medium sm:text-4xl"
    >
      {t('cta.title')}
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-lg text-[var(--fg-muted)]">{t('cta.body')}</p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={SIGNUP_TRIAL_URL}
        class="ai-gradient-bg w-full rounded-lg px-6 py-3 text-base font-medium text-white sm:w-auto"
      >
        {t('cta.primary')}
      </a>
      <a
        href="mailto:contact@tblflow.com"
        class="w-full rounded-lg border border-[var(--border-strong)] px-6 py-3 text-base font-medium transition-colors hover:bg-[var(--bg-subtle)] sm:w-auto"
      >
        {t('cta.secondary')}
      </a>
    </div>
  </div>
</section>
