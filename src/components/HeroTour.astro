    font-size: 10.5px;
    line-height: 1.6;
    color: var(--tf-muted);
  }
  .ht-log p {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 400ms var(--ease-out-soft), transform 400ms var(--ease-out-soft);
  }
  .ht-log p.is-show {
    opacity: 1;
    transform: none;
  }

  /* 5. Approval */
  .ht-appr {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 8%;
    padding: 12px;
    border: 1px solid var(--tf-warning);
    border-radius: 12px;
    background: var(--tf-card);
    transition: border-color 500ms;
  }
  .is-sent .ht-appr {
    border-color: var(--tf-success);
  }
  .ht-appr__q {
    font-size: 13.5px;
    font-weight: 600;
  }
  .ht-appr__mail {
    margin: 8px 0 10px;
    padding: 7px 9px;
    border-radius: 8px;
    background: var(--tf-head);
