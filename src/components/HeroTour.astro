  }
  .ht-pill {
    justify-self: start;
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 10.5px;
  }
  .ht-pill.is-ok {
    color: var(--tf-positive);
    background: var(--tf-positive-bg);
  }
  .ht-pill.is-late {
    color: var(--tf-warning);
    background: color-mix(in oklab, var(--tf-warning) 12%, transparent);
  }
  .ht-kan {
    display: grid;
