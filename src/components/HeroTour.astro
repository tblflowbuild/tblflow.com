  }
  .is-swapped .ht-tile.is-rep .ht-tile__lg {
    opacity: 0;
  }
  .is-swapped .ht-tile.is-rep :is(.ht-tile__mk, .ht-tile__tl) {
    opacity: 1;
  }
  .is-swapped .ht-tile:not(.is-rep) {
    opacity: 0.5;
  }
  .ht-legend {
    position: absolute;
    left: 5%;
    top: 4%;
    display: flex;
    gap: 12px;
    font-size: 10.5px;
    color: var(--tf-muted);
    opacity: 0;
    transition: opacity 600ms;
  }
  .is-swapped .ht-legend {
    opacity: 1;
  }
  .ht-legend span::before {
    content: '';
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 5px;
    border: 1px solid var(--tf-border-high);
    border-radius: 3px;
    background: var(--ht-tile);
    vertical-align: -1px;
  }
  .ht-legend .is-rep {
    color: var(--ht-accent);
  }
  .ht-legend .is-rep::before {
    border-color: var(--ht-accent);
    background: var(--ht-accent-soft);
  }
  .ht-cap {
    position: absolute;
    left: 50%;
    bottom: 3%;
    display: grid;
    width: max-content;
    max-width: 92%;
    padding: 5px 12px;
    border: 1px solid var(--ht-accent);
    border-radius: 12px;
    background: var(--tf-card);
    font-size: 11.5px;
    line-height: 1.4;
    text-align: center;
    opacity: 0;
    transform: translate(-50%, 8px);
    transition: opacity 600ms var(--ease-out-soft), transform 600ms var(--ease-out-soft);
  }
  .ht-cap > span {
    grid-area: 1 / 1;
    transition: opacity 400ms;
  }
  .is-joined .ht-cap {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .ht-cap__b,
  .is-swapped .ht-cap__a {
