  }
  .ht-done strong {
    font-weight: 600;
    color: var(--tf-positive);
  }
  .ht-roles {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 6%;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ht-roles span {
    padding: 2px 9px;
