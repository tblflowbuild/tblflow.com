  }

  /* One scene at a time; the others fade out and leave the accessibility tree. */
  .ht [data-i] {
    opacity: 0;
    visibility: hidden;
    transition: opacity 400ms var(--ease-out-soft), visibility 400ms;
  }
  :is(#ht-r0:checked ~ .ht-window [data-i='0'], #ht-r1:checked ~ .ht-window [data-i='1'], #ht-r2:checked ~ .ht-window [data-i='2'], #ht-r3:checked ~ .ht-window [data-i='3'], #ht-r4:checked ~ .ht-window [data-i='4']) {
    opacity: 1;
    visibility: visible;
  }

  /* Stage: title above the illustration and the text below on phones; text left, illustration right from md. */
  .ht-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'head' 'canvas' 'body';
    gap: 14px;
    padding: 1.25rem;
  }
  @media (min-width: 768px) {
    .ht-stage {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-areas: 'head canvas' 'body canvas';
      gap: 0 1.75rem;
      padding: 1.75rem;
      align-items: center;
    }
    .ht-heads {
      align-self: end;
    }
    .ht-bodies {
      align-self: start;
    }
  }
  .ht-heads {
    grid-area: head;
  }
  .ht-bodies {
    grid-area: body;
  }
  .ht-heads,
  .ht-bodies {
    display: grid;
  }
  .ht-text {
    grid-area: 1 / 1;
  }
  .ht-num {
    font-size: 11px;
    color: var(--ht-accent);
  }
  .ht-h {
    margin: 6px 0 12px;
    font-size: 19px;
    line-height: 1.3;
    font-weight: 600;
    color: var(--tf-fg);
    text-wrap: balance;
  }
  .ht-p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--tf-muted);
  }
  .ht-ex {
    margin-top: 12px;
    padding: 8px 10px;
    border-left: 2px solid var(--ht-accent);
    border-radius: 0 8px 8px 0;
    background: var(--tf-note-bg);
    font-size: 12.5px;
    color: var(--tf-fg);
  }

  .ht-canvas {
    grid-area: canvas;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--tf-border-high);
    border-radius: 12px;
    background: var(--tf-grid-bg);
    touch-action: pan-y;
  }
  @media (min-width: 768px) {
    .ht-canvas {
      aspect-ratio: 16 / 11;
    }
  }
  .ht-scene {
    position: absolute;
    inset: 0;
  }
  .ht-logo {
    display: grid;
    flex: none;
    place-items: center;
    border: 1px solid var(--tf-border-high);
    border-radius: 6px;
    background: var(--ht-tile);
  }
  .ht-logo svg,
  .ht-tile svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* 1. Tools */
  .ht-tile {
    position: absolute;
    width: 11.5%;
    aspect-ratio: 1;
    border: 1px solid var(--tf-border-high);
    border-radius: 10px;
    background: var(--ht-tile);
    transition: left 1s var(--ease-out-soft), top 1s var(--ease-out-soft), border-color 600ms, background-color 600ms, opacity 600ms;
    animation: ht-drift 5s ease-in-out infinite alternate;
    animation-delay: var(--d);
  }
  @media (max-width: 767px) {
    .ht-tile {
      width: 14%;
    }
  }
  .is-joined .ht-tile {
    animation: none;
  }
  @keyframes ht-drift {
    from {
      transform: translate(-5px, -4px) rotate(-3deg);
    }
    to {
      transform: translate(5px, 4px) rotate(3deg);
    }
  }
  .ht-tile__lg,
  .ht-tile__mk {
    position: absolute;
    inset: 18%;
    transition: opacity 600ms var(--ease-out-soft);
  }
  .ht-tile__mk {
    opacity: 0;
    color: var(--rc);
  }
  .ht-tile__tl {
    position: absolute;
    left: 50%;
    top: calc(100% + 3px);
    transform: translateX(-50%);
    font-size: 10px;
    line-height: 12px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--rc);
    opacity: 0;
    transition: opacity 600ms;
  }
  .is-swapped .ht-tile.is-rep {
    border-color: var(--rc);
