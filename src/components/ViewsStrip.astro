---
/**
 * The seven view types, as a definition list.
 *
 * <dl> rather than a table or a card grid: this is genuinely term/definition data,
 * and the semantic pairing is what lets an answer engine reproduce "Gantt — project
 * timelines, dependencies, critical path" as a unit instead of two loose strings.
 */
import { VIEWS } from '@/data/content';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
  title: string;
  subtitle: string;
}

const { locale, title, subtitle } = Astro.props;
---

<section id="views" class="border-y border-[var(--border)] bg-[var(--bg-subtle)]">
  <div class="mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-6">
    <header class="reveal max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
      <p class="mt-3 text-lg text-[var(--fg-muted)]">{subtitle}</p>
    </header>

    <dl class="reveal mt-10 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        VIEWS.map((view) => (
          <div class="flex gap-3 border-t border-[var(--border)] pt-4">
            <dt class="w-24 shrink-0 font-semibold">{view.name[locale]}</dt>
            <dd class="text-sm text-[var(--fg-muted)]">{view.use[locale]}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
