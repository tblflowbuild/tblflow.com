---
/**
 * The six view types, as a small animated diagram each — Grid, Kanban,
 * Gallery, Calendar, Gantt, Form.
 *
 * Copy still comes from `VIEWS` in `@/data/content.ts`: that array is also
 * what `llms-full.txt` and the JSON-LD reuse, so the visible text and the
 * machine-readable one cannot drift apart. Only the presentation changed —
 * a card with a heading and a paragraph keeps the same "one quotable unit per
 * view" property a `<dl>` had, without giving up the fuller illustration.
 *
 * Every stage animation is `aria-hidden`: it shows what the text already
 * says, and CSS animation is muted globally under `prefers-reduced-motion`.
 */
import { VIEWS } from '@/data/content';
import { useTranslations } from '@/i18n/ui';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
  title: string;
  subtitle: string;
}

const { locale, title, subtitle } = Astro.props;
const t = useTranslations(locale);
const [grid, kanban, gallery, calendar, gantt, form] = VIEWS;
---

<section id="views">
  <div class="mx-auto max-w-6xl scroll-mt-24 px-4 py-20 sm:px-6">
    <header class="reveal max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
      <p class="mt-3 text-lg text-[var(--fg-muted)]">{subtitle}</p>
    </header>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {/* Grille */}
      <li class="reveal card overflow-hidden">
        <div class="vt-stage" aria-hidden="true">
          <div class="vt-grid">
            {Array.from({ length: 15 }).map((_, i) => (
              <div class:list={['vt-cell', [0, 3, 4, 7, 10, 13].includes(i) && 'vt-cell--blank']} />
            ))}
            <div class="vt-select"></div>
          </div>
        </div>
        <div class="p-4">
          <h3 class="text-base font-semibold">{grid.name[locale]}</h3>
          <p class="mt-1 text-sm text-[var(--fg-muted)]">{grid.use[locale]}</p>
        </div>
      </li>

      {/* Kanban */}
      <li class="reveal card overflow-hidden">
        <div class="vt-stage" aria-hidden="true">
          <div class="vt-kanban">
            <div class="vt-kcol">
              <span class="vt-kcol-label">{t('views.kanban.todo')}</span>
              <div class="vt-kcard"></div>
              <div class="vt-kcard vt-kcard--ghost"></div>
            </div>
            <div class="vt-kcol">
              <span class="vt-kcol-label">{t('views.kanban.inprogress')}</span>
              <div class="vt-kcard vt-kcard--ghost"></div>
            </div>
            <div class="vt-kcol">
              <span class="vt-kcol-label">{t('views.kanban.done')}</span>
              <div class="vt-kcard"></div>
            </div>
            <div class="vt-kfly"></div>
          </div>
        </div>
        <div class="p-4">
          <h3 class="text-base font-semibold">{kanban.name[locale]}</h3>
          <p class="mt-1 text-sm text-[var(--fg-muted)]">{kanban.use[locale]}</p>
        </div>
      </li>

      {/* Galerie */}
      <li class="reveal card overflow-hidden">
        <div class="vt-stage" aria-hidden="true">
          <div class="vt-gallery">
            {Array.from({ length: 6 }).map(() => (
              <div class="vt-tile">
                <svg viewBox="0 0 24 24">
                  <rect x="3" y="4" width="18" height="16" rx="1.5"></rect>
                  <circle cx="8.5" cy="9.5" r="1.5"></circle>
                  <path d="M3 16l5-5 4 4 3-3 6 6"></path>
                </svg>
              </div>
            ))}
          </div>
        </div>
        <div class="p-4">
          <h3 class="text-base font-semibold">{gallery.name[locale]}</h3>
          <p class="mt-1 text-sm text-[var(--fg-muted)]">{gallery.use[locale]}</p>
        </div>
      </li>

      {/* Calendrier */}
      <li class="reveal card overflow-hidden">
        <div class="vt-stage" aria-hidden="true">
          <div class="vt-cal">
            <div class="vt-cal-sweep"></div>
            {Array.from({ length: 28 }).map(() => (
              <div class="vt-cal-cell"></div>
            ))}
            <div class="vt-cal-dot" style="left: 22%; top: 34%;"></div>
            <div class="vt-cal-dot" style="left: 50%; top: 60%; animation-delay: 1.6s;"></div>
            <div class="vt-cal-dot" style="left: 74%; top: 34%; animation-delay: 3.2s;"></div>
          </div>
        </div>
        <div class="p-4">
          <h3 class="text-base font-semibold">{calendar.name[locale]}</h3>
          <p class="mt-1 text-sm text-[var(--fg-muted)]">{calendar.use[locale]}</p>
        </div>
      </li>

      {/* Gantt */}
      <li class="reveal card overflow-hidden">
        <div class="vt-stage" aria-hidden="true">
          <div class="vt-gantt">
            <div class="vt-today"></div>
            <div class="vt-row"><div class="vt-bar vt-bar--critical" style="left:6%; width:34%;"></div></div>
            <div class="vt-row">
              <div class="vt-elbow" style="left:6%; width:6%; height:60%; top:-60%;"></div>
              <div class="vt-bar vt-bar--critical" style="left:40%; width:30%;"></div>
            </div>
            <div class="vt-row"><div class="vt-bar" style="left:14%; width:24%;"></div></div>
            <div class="vt-row">
              <div class="vt-elbow" style="left:70%; width:6%; height:60%; top:-60%;"></div>
              <div class="vt-bar vt-bar--critical" style="left:70%; width:24%;"></div>
            </div>
          </div>
        </div>
        <div class="p-4">
          <h3 class="text-base font-semibold">{gantt.name[locale]}</h3>
          <p class="mt-1 text-sm text-[var(--fg-muted)]">{gantt.use[locale]}</p>
        </div>
      </li>

      {/* Formulaire */}
      <li class="reveal card overflow-hidden">
        <div class="vt-stage" aria-hidden="true">
          <div class="vt-form">
            <div class="vt-form-url">
              <svg viewBox="0 0 24 24">
                <path d="M10 14a4 4 0 0 0 6 0l3-3a4 4 0 0 0-6-6l-1.5 1.5"></path>
                <path d="M14 10a4 4 0 0 0-6 0l-3 3a4 4 0 0 0 6 6l1.5-1.5"></path>
              </svg>
              <span>tblflow.com/f/x9k2</span>
            </div>
            <div class="vt-field"><div class="vt-flabel"></div><div class="vt-finput"><div class="vt-finput-fill"></div></div></div>
            <div class="vt-field"><div class="vt-flabel"></div><div class="vt-finput"><div class="vt-finput-fill"></div></div></div>
            <div class="vt-submit">{t('views.mock.submit')}</div>
          </div>
        </div>
        <div class="p-4">
          <h3 class="text-base font-semibold">{form.name[locale]}</h3>
          <p class="mt-1 text-sm text-[var(--fg-muted)]">{form.use[locale]}</p>
        </div>
      </li>
    </ul>
  </div>
</section>
