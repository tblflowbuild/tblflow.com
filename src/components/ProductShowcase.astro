---
/**
 * Two real screenshots of the product, not another diagram.
 *
 * Every other section on this page — Pipeline, Surfaces, Views — illustrates
 * TblFlow with hand-built animated mockups, deliberately: they stay crisp at
 * any density and never go stale when the real UI moves. That's the right
 * call for explaining a mechanism, but a visitor who has scrolled through
 * three sections of stylised diagrams has not yet seen the actual product.
 * This section is the one grounding moment: real data, real screens.
 */
import { useTranslations } from '@/i18n/ui';
import type { Locale } from '@/config';

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
const t = useTranslations(locale);

const shots = [
  {
    src: '/images/product/contacts-table.png',
    width: 2582,
    height: 1636,
    captionKey: 'showcase.table.caption' as const,
  },
  {
    src: '/images/product/schema-relationnel.png',
    width: 2888,
    height: 1714,
    captionKey: 'showcase.schema.caption' as const,
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <header class="reveal mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t('showcase.title')}</h2>
    <p class="mt-3 text-lg text-[var(--fg-muted)]">{t('showcase.subtitle')}</p>
  </header>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {
      shots.map((shot) => (
        <figure class="reveal card overflow-hidden">
          <div class="flex items-center gap-1.5 border-b border-[var(--border)] px-3 py-2.5">
            <span class="h-2 w-2 rounded-full bg-[var(--fg-subtle)] opacity-40" />
            <span class="h-2 w-2 rounded-full bg-[var(--fg-subtle)] opacity-40" />
            <span class="h-2 w-2 rounded-full bg-[var(--fg-subtle)] opacity-40" />
          </div>
          <img
            src={shot.src}
            width={shot.width}
            height={shot.height}
            loading="lazy"
            decoding="async"
            alt={t(shot.captionKey)}
            class="block w-full"
          />
          <figcaption class="border-t border-[var(--border)] px-4 py-3 text-sm text-[var(--fg-muted)]">
            {t(shot.captionKey)}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
