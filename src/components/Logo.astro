---
/**
 * The TblFlow mark, inlined rather than loaded as an <img>.
 *
 * Inlining is what makes the entrance animation possible at all: the mark is
 * four independent isometric boxes, and each can only be staggered separately
 * if the SVG nodes are in the document. It also removes a request from the
 * critical path for something that appears in the header of every page.
 *
 * The geometry lives in `@/data/logo-mark.mjs`, shared with the favicon and the
 * Open Graph card so the three cannot drift apart.
 *
 * `animate` adds a staggered entrance — used once in the hero, not in the
 * header, because a mark that re-animates on every navigation stops reading as
 * delight. The class is defined under `prefers-reduced-motion: no-preference`
 * only.
 */
import { MARK_BOXES, MARK_GRADIENT, MARK_VIEWBOX } from '@/data/logo-mark.mjs';

interface Props {
  size?: number;
  animate?: boolean;
  class?: string;
  /** Decorative when the adjacent text already names the brand. */
  title?: string;
}

const { size = 32, animate = false, class: className = '', title } = Astro.props;
const boxClass = animate ? 'logo-tile' : '';
/* The mark renders more than once per page (header and footer), so the
   gradient id has to be unique or the second instance reuses the first's. */
const uid = Math.random().toString(36).slice(2, 8);
const gradientId = `mark-${uid}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={MARK_VIEWBOX}
  width={size}
  height={size}
  class={className}
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      {MARK_GRADIENT.map((stop) => <stop offset={stop.offset} stop-color={stop.color} />)}
    </linearGradient>
  </defs>

  {/* One <g> per box so the stagger can address them individually. */}
  {
    MARK_BOXES.map((box) => (
      <g class={boxClass}>
        <polygon points={box.points.left} fill={box.fill.left} />
        <polygon points={box.points.right} fill={box.fill.right} />
        <polygon points={box.points.top} fill={box.fill.top ?? `url(#${gradientId})`} />
      </g>
    ))
  }
</svg>
